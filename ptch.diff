diff --git a/isr.c b/isr.c
index de00663..ecbb232 100644
--- a/isr.c
+++ b/isr.c
@@ -356,12 +356,18 @@ void isr_handler(struct regs *r)
             //Увеличиваем системные тики
             tick_count++;
 
-            //Обновляем мигание курсора TTY
-            kconsole_update_cursor();
-
-            if ((tick_count & 5) == 0)
+            //пока держится блокировка планировщика (смена режима, spawn)
+            //— рисовать из IRQ нельзя: LFB и CRTC в этот момент
+            //перепрограммируются, состояние графического слоя недействительно
+            if (kernel_schedule_lock == 0)
             {
-                kernel_load_animation_next_step();
+                //Обновляем мигание курсора TTY
+                kconsole_update_cursor();
+
+                if ((tick_count & 5) == 0)
+                {
+                    kernel_load_animation_next_step();
+                }
             }
 
             if (kernel_schedule_lock == 1) return;
diff --git a/syscalls.c b/syscalls.c
index 9b0fed0..6f603be 100644
--- a/syscalls.c
+++ b/syscalls.c
@@ -2236,15 +2236,26 @@ void systemcall_graph_info(struct regs *r)
             com_puts("[GINFO] set_mode idx=");
             com_puthex(r->ecx);
             com_puts("\n");
+            //смена режима — атомарная секция ядра: таймер не должен
+            //вытеснять контекст задачи посреди gr_set_mode. внутри нее
+            //ядро меняет глобальное состояние графического слоя, а
+            //тримплин real mode (vbe_rm_exec) уходит в BIOS int 10h;
+            //прилетевший посреди этого IRQ0 с schedule() переключает
+            //CR3/esp, и контекст продолжения смены режима становится
+            //мусором. держим блокировку до конца redraw консолей
+            uint8_t saved_sched_lock = kernel_schedule_lock;
+            kernel_schedule_lock = 1;
             int rc = gr_set_mode(r->ecx);
             if (rc != GR_OK)
             {
+                kernel_schedule_lock = saved_sched_lock;
                 r->eax = (uint32_t)rc;
                 return;
             }
             //геометрия консолей привязана к разрешению: пересчитываем окна
             //TTY под новый режим и очищаем экран
             kconsole_mode_changed();
+            kernel_schedule_lock = saved_sched_lock;
             r->eax = 0;
             break;
         }
diff --git a/vbe_rm.c b/vbe_rm.c
index 75855c1..8c126fb 100644
--- a/vbe_rm.c
+++ b/vbe_rm.c
@@ -32,9 +32,10 @@ extern const uint8_t vbe_rm_blob_start[];
 extern const uint8_t vbe_rm_blob_end[];
 
 //метка целостности лежит в служебной зоне за кодом блоба: код занимает
-//0x4000..~0x4215 (с маяками), вход 0x4300, результат 0x4320, ячейки
-//0x4340..0x434f, так что 0x4350 никем не трогается. если младшую память
-//кто-то затер, метка исчезнет и vbe_rm_exec откажется прыгать в чужой код
+//0x4000..~0x4290 (с маяками и RM-ловушками IVT 0x4240/0x4270), вход
+//0x4300, результат 0x4320, ячейки 0x4340..0x434f, так что 0x4350 никем
+//не трогается. если младшую память кто-то затер, метка исчезнет и
+//vbe_rm_exec откажется прыгать в чужой код
 #define VBE_RM_MAGIC_ADDR 0x4350
 #define VBE_RM_MAGIC      0x5652454Du
 
diff --git a/vbe_rm_blob.asm b/vbe_rm_blob.asm
index bad6901..a935b37 100644
--- a/vbe_rm_blob.asm
+++ b/vbe_rm_blob.asm
@@ -34,8 +34,11 @@
 ;Карта блоба (смещения от начала — фиксированные, между секциями times):
 ;  0x000..0x07F  32-битный вход: сохранение контекста, маскировка IRQ
 ;  0x080..0x0BF  16-битный PM: выключение PG и PE
-;  0x0C0..0x17F  реальный режим: параметры из 0x4300, int 10h, результат в 0x4320
-;  0x180..       возврат в 32-битный PM и retf
+;  0x0C0..0x17F  реальный режим: сетка IVT, параметры из 0x4300,
+;                int 10h, результат в 0x4320
+;  0x180..0x23F  возврат в 32-битный PM и retf
+;  0x240..0x26F  RM-ловушка исключений IVT (beacon 'E' + iret)
+;  0x270..0x28F  RM-ловушка IRQ IVT (EOI + beacon 'i' + iret)
 ;Служебные ячейки вынесены ЗА пределы блоба (0x4340..0x434f), чтобы запись
 ;esp/ss при входе физически не могла затереть код возврата:
 ;  0x4340 ESP вызывающего, 0x4344 SS, 0x4348/0x4349 маски PIC, 0x434C флаг IF
@@ -50,16 +53,25 @@
 ;  '3' PG выключен (16-битный PM)
 ;  '4' PE выключен (реальный режим)
 ;  '5' сегменты/стек RM готовы
-;  '6' параметры ещё не загружены, int 10h впереди
+;  '6' сетка IVT установлена, параметры ещё не загружены, int 10h впереди
 ;  '7' BIOS вернулся, результаты сложены в 0x4320
 ;  '8' возврат в 32-битный PM
 ;  '9' CR0/CR3 восстановлены (PG снова включен)
 ;  'a' маски PIC восстановлены
 ;  'b' всё готово, retf
+;  'E' в RM сработала ловушка исключения IVT (fault внутри BIOS)
+;  'i' в RM сработала ловушка IRQ (прерывание просочилось сквозь маски)
 ;Маяк — один байт; comch ждёт готовности THR (LSR.5), символы не теряются.
 
 BITS 32
 
+;ловушки IVT: смещения внутри блоба (линейные адреса 0x4000+off) и
+;сегмент реального режима для IVT-записей. видимое CS = 0x0400 дает
+;базу 0x4000, так что 0x0400:TRAP_*_OFF указывает ровно на стабы
+%define TRAP_EXC_OFF 0x0240
+%define TRAP_IRQ_OFF 0x0270
+%define TRAP_SEG     0x0400
+
 %macro comch 1
     mov dx, 0x3FD
 %%com_wait:
@@ -145,6 +157,28 @@ real_part:
     mov sp, 0x7000           ;свой стек в свободной младшей памяти
     comch '5'
 
+    ;защитная сетка IVT перед int 10h: BIOS внутри int 10h сам включает
+    ;IF (seaBIOS entry_10 делает sti), а векторы переназначенных IRQ
+    ;0x20-0x2F BIOS никогда не заполнял — там лежит мусор младшей памяти
+    ;(остатки данных ядра/загрузчика). просочившийся IRQ исполняет эти
+    ;данные как код: мусорные байты в COM1, затем jmp $ — ровно то, что
+    ;видно в журнале после маяка '6'. развешиваем ловушки: исключения
+    ;0x00-0x0F -> beacon 'E' + iret, IRQ 0x20-0x2F -> EOI + beacon 'i'
+    ;+ iret. вектор 0x10 не трогаем — это сам int 10h
+    mov di, 0x00
+    mov cx, 0x10
+.rm_ivt_exc:
+    mov word [di], TRAP_EXC_OFF      ;offset ловушки
+    mov word [di+2], TRAP_SEG        ;segment 0x0400 (база 0x4000)
+    add di, 4
+    loop .rm_ivt_exc
+    mov di, 0x80                     ;вектор 0x20*4 = 0x80
+    mov cx, 0x10
+.rm_ivt_irq:
+    mov word [di], TRAP_IRQ_OFF
+    mov word [di+2], TRAP_SEG
+    add di, 4
+    loop .rm_ivt_irq
     comch '6'
     ;параметры вызова из блока 0x4300
     mov ax, [0x4300]         ;AX
@@ -209,4 +243,34 @@ pm32_ret:
     comch 'b'
     retf
 
+;-------------- RM-ловушки IVT (защитная сетка) --------------
+;вызываются только из реального режима, когда просочился IRQ или BIOS
+;поймал исключение. CS при входе = 0x0400 (база 0x4000), стек любой —
+;push/pop работают с текущим SS. EOI обоим PIC unconditional: для
+;исключений это безопасно, для spurious IRQ7/15 — обязательная часть
+;обработки. все потревоженные регистры сохраняются: BIOS не должен
+;заметить ловушку
+
+times (TRAP_EXC_OFF - ($-vbe_rm_blob_start)) db 0
+BITS 16
+rm_trap_exc:
+    push ax
+    push dx
+    mov al, 0x20
+    out 0xA0, al             ;EOI и здесь: векторы 0x08-0x0F — это еще и
+    out 0x20, al             ;legacy IRQ0-7, если базу PIC кто-то вернул
+    comch 'E'                ;маяк: исключение поймано ловушкой
+    pop dx
+    pop ax
+    iret
+
+times (TRAP_IRQ_OFF - ($-vbe_rm_blob_start)) db 0
+rm_trap_irq:
+    push ax
+    push dx
+    mov al, 0x20
+    out 0xA0, al             ;EOI slave сначала (если IRQ пришёл от него)
+    out 0x20, al             ;EOI master
+    comch 'i'                ;маяк: IRQ просочился сквозь маски
+    pop dx
+    pop ax
+    iret
+
 vbe_rm_blob_end: