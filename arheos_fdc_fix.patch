diff --git a/include/debug.inc b/include/debug.inc
index ccc92f9..52c17de 100644
--- a/include/debug.inc
+++ b/include/debug.inc
@@ -394,8 +394,18 @@ screen_hex_nibble:
     ret
 
 ;Вывод байта AL на экран в HEX
+;ВНИМАНИЕ: BX СОХРАНЯЕТСЯ. Раньше BL использовался как временный
+;регистр без сохранения, а вызыватели (dbg_dump_esbx в f12ld.asm и
+;дамп .give_up в fat12_stage2.inc) держат в BX УКАЗАТЕЛЬ буфера:
+;после первого же байта BL затирался значением байта, указатель
+;прыгал на (байт+1), и дамп печатал ЧУЖИЕ байты корневого каталога
+;(на реальном железе И в QEMU одинаковый «мусор» вида
+;"46 20 45 20 45..." / "F9 80 57 C0" вместо "F12    LD " /
+;"F9 FF FF 03"). Из-за этого мусорные дампы выглядели как
+;порча данных, хотя чтение было чистым.
 screen_hex_byte:
     push ax
+    push bx           ;+++ BL временный: BX у вызывателей — указатель
     mov bl, al        ;Сохраняем байт в BL
 
     shr al, 4         ;Старший ниббл
@@ -404,6 +414,7 @@ screen_hex_byte:
     mov al, bl        ;Младший ниббл
     call screen_hex_nibble
 
+    pop bx
     pop ax
     ret
 
diff --git a/include/fdc_pio.inc b/include/fdc_pio.inc
index 33a526d..2bd821d 100644
--- a/include/fdc_pio.inc
+++ b/include/fdc_pio.inc
@@ -39,7 +39,10 @@
 ;   'r0'/'r2' из bpb_init — проба скорости 500/250 кбит/с.
 ;   'B' — FDC на машине нет (шина 0x3F4 читается 0xFF, напр. загрузка
