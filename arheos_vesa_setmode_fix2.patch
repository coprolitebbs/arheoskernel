diff --git a/graphic_layer.c b/graphic_layer.c
index 799f1d8..e83d1ae 100644
--- a/graphic_layer.c
+++ b/graphic_layer.c
@@ -467,21 +467,158 @@ static uint8_t  *gr_wallpaper_raw = 0;
