; ============================================================
; fdc_pio.inc — дисковый слой stage2 (флоппи).
;
; Стратегия "Лестница + верификация"
;
;Cхема (ред. 12 — п.9: PIO-первичный; п.10: DMA-фаза данных):
;   1) Ярус 1 — PIO (fdc_reset: SPECIFY ND=0, CCR, recal/seek, READ с
;      фазой данных через ISA DMA CH2 — см. п.10).
;      каждая фаза ограничена таймаутами — PIO висеть не может в принципе.
;      FDC не трогаем, только когда он не декодируется (pio_dead -> сразу BIOS).
;   1а) Фолбэк — BIOS int 13h (доказанный путь stage1 на C0..C2, "лестница" поднимается к нему при сбоях PIO).
;   2) SPECIFY с ND=0 ВСЕГДА (fdc_reset, fdc_recover_bios, fdc_read_op):
;      non-DMA (ND=1) на CS5530 вешает recalibrate (п.8) и уводит чип
;      в исполнение посреди командной фазы READ ('f630': RQM=0,
;      DIO=1, NDM=1 — чип перестаёт принимать байты команды).
;      ВАЖНО: бит 0 третьего байта SPECIFY — это ND; ND=0 = 0x04, ND=1 = 0x05/0x15.
;   3) fdc_out оставлен с классической проверкой RQM|DIO: биты ACT у 82077+ установлены в
;      режиме поллинга и после RESET, так что "строгий покой" по MSR отличить от застрявшего
;      seek-а невозможно в принципе. Вместо этого гарантии даёт порядок:
;      Перед каждым SPECIFY-в-неуверенном-состоянии стоит импульс RESET в DOR
;      (fdc_dor_pulse / fdc_reset), прерывающий любую зависшую команду;
;      ND=1 включается только в fdc_read_op.
;   4) fdc_recover_bios перед любым возвратом на BIOS после PIO:
;      импульс RESET в DOR -> ожидание покоя MSR=0x80 по тикам ->
;      осушение SENSE -> SPECIFY ND=0 при гарантированном покое ->
;      AH=00 BIOS -> кэш цилиндра BIOS 0x40:0x94/95 = 0.
;   5) Лестница из 8 шагов на каждый сектор (fdc_read_lba):
;        0,1 — чистая попытка текущим ярусом;
;        2   — восстановление текущего яруса;
;        3   — цикл мотора (выкл/пауза/вкл) + восстановление;
;        4   — Смена яруса (BIOS<->PIO) + восстановление;
;        5   — чистая попытка новым ярусом;
;        6   — цикл мотора + восстановление;
;        7   — смена яруса + восстановление.
;      Сдача — только после всех 8. Успех на шаге N>0 переводит следующие секторы на шаг N-1
;      (мягкий спуск к быстрому пути).
;   6) Верификация данных (BIOS может вернуть CF=0 с мусором):
;      - bpb_init ( в f12ld.asm_ ) проверяет 0xAA55 и полевые ограничения BPB — мусорный сектор
;        0 = несостоявшееся чтение (лестница перезапустится);
;      - fdc_verify_cluster перечитывает первый кластер каждого файла (драйверы, ядро) в
;        scratch 0000:0x2000 и сравнивает байт-в-байт:
;        два чтения дали разное = порча (маркер 'V'), кластер перечитывается, при повторной порче — ошибка.
;   7) Пока скорость не подтверждена (BPB ещё не разобран), PIO-ярус ротирует скорости 500->250->300 кбит/с по попыткам
;      (маркеры 'r0'/'r2'/'r1' — код CCR 0/2/1).
;
;   8) На реальном железе (загрузка TA-NC529): SPECIFY в fdc_reset/fdc_recover_bios
;      писался байтом 0x05, а у SPECIFY бит 0 = ND.
;      0x05 = ND=1 — "исправление ND=0" из п.2 шапки не применялось вовсе:
;      recalibrate с ND=1 на CS5530 не завершался (лог железа: r0/r2/r1 + 'f481' + 'F4 800000 M81'
;      лестницами), загрузка шла только после случайного BIOS AH=00, а выживший ND=1
;      портил данные последующих BIOS-чтений (дампы F9 80 57 C0 / 46 20 45 20 45... при чистом CRC).
;      Теперь SPECIFY ND=0 = байт 0x04 (бит 0 сброшен, HLT тот же).
;      Симптомы там же: 'f481' = фаза 4 (RECALIBRATE), MSR=0x81, SENSE INTERRUPT вечно INVALID (ST0=0x80).
;
;   9) Первичный ярус — PIO (fdc_tier=1), BIOS — фолбэк.
;
;   10) РЕД. 12 (сессия «дискета крутит, загрузка мертва»). Лог железа:
;      LS>r0af481 r2af630 L2 r1af481 L3 r0abcf630 L4 — и вечный мотор.
;      Разбор: (а) на дискете СТАРЫЙ f12ld.bin: во всех собранных
;      образах есть только SPECIFY ND=1 (03/CF/15) из fdc_read_op,
;      ND=0-фикс п.8 в бинарники не попал вовсе ('f481' — ровно
;      симптом п.8; пара 'b'+'c' в одной попытке невозможна в ред. 11:
;      после успешного recal seek до C0 пропускается); (б) 'f630' —
;      ND=1 уводит чип в исполнение посреди выдачи команды READ
;      (MSR=0x30); (в) после 'L4' тишина БЕЗ маркера 'B' — завис
;      fdc_recover_bios: единственный неограниченный шаг — int 13h
;      AH=00, BIOS ждёт IRQ6 вечно. Меры РЕД. 12:
;      - фаза данных READ переведена с ND-поллинга на ISA DMA CH2
;        (механизм stage1/BIOS, доказанный на этой машине: stage1
;        читает дискету через DMA безупречно) — ND=1 больше не
;        используется НИГДЕ;
;      - fdc_wait_seek_done проверяет завершение физически через
;        SENSE DRIVE STATUS (recal: ST3.T0=1; seek: чип в покое) —
;        потерянное прерывание больше не роняет попытку;
;      - из fdc_recover_bios исключён int 13h AH=00: состояние BIOS
;        синхронизируется вручную (счётчик мотора, кэш цилиндра
;        0x94/95, recal-pending биты 0x40:0x3E, бит мотора); BIOS-ярус
;        остаётся только на AH=02 и без внутреннего recal.
;
;   11) РЕД. 13 (сессия «Sl>r0af481 r2a — тишина, мотор крутит вечно»).
;      Три причины зависания, все устранены:
;      (а) fdc_out затирал CX (mov cx, TMO_BYTEC) не сохраняя. В
;      fdc_wait_seek_done в CX живёт стартовый тик дедлайна: после
;      .wsd_sts (SENSE DRIVE STATUS) дедлайн считал от мусора —
;      либо мгновенный выход (recal «всегда провален», маркер
;      'f481' даже при реально завершённом recal), либо вечный
;      цикл при стоящем счётчике тиков. Теперь fdc_out сохраняет
;      CX, дедлайн считается от настоящего старта.
;      (б) дедлайны wait_seek_done/wait_idle были ТОЛЬКО по тикам
;      BIOS (0x40:0x6C): при неработающем int 08h оба крутились
;      вечно. Теперь у обоих есть итерационный кап — выход
;      гарантирован при любых обстоятельствах (маркер 'Q' = кап
;      сработал, тики стоят — диагностика для следующего лога).
;      (в) IRQ6 размаскивался между попытками (восстановление маски
;      в .done fdc_pio_read): завершившийся задним числом recal
;      получал прерывание в окно, когда чип в самодельном состоянии,
;      и обработчик int 0Eh BIOS уходил в ожидание фазы результатов
;      без таймаута, а выполняется он с IF=0 — тики стоят, мотор
;      не гасится никогда (гашение мотора делает обработчик int 08h),
;      экран молчит. Именно этот класс зависаний даёт симлтом
;      «мотор крутит бесконечно». Теперь IRQ6 маскируется один раз
;      в fdc_drv_init и держится весь stage2; разрешение — только
;      вокруг int 13h (fdc_bios_read), с повторной маскировкой и
;      осушением результатов после.
;
;   14) РЕД. 16 (сессия «Sl>r0af481 r2123a4267f710 L2 123r1123a4f481
;      L3 123r0123a4f481 L4 B00 WB00 eD»). Лог железа после РЕД. 15:
;      PIO-попытки 1/3/4 гибнут на RECALIBRATE ('f481'), попытка 2
;      (300 кбит/с) прошла recal, выдала READ и повисла в фазе данных
;      ('f710', MSR=0x10 — чип ждёт циклов DMA), BIOS-ярус прочитал
;      сектор 0 ('W') и провалился на FAT ('e' + "Disk error").
;      Разбор по коду: маркера 'Q' в логе нет НИ РАЗУ — wait_seek_done
;      ни разу не сдался по дедлайну, значит recal завершался, но SENSEI
;      отдавал ГРЯЗНЫЙ ST0 (IC!=00 / EC / PCN!=0), который fdc_recal
;      отвергал. 'f710' при MSR=0x10: READ исполняется, фазы результатов
;      нет за весь TMO_CMD (~3 c) — данные либо не пошли по DMA, либо
;      ушли, но чип не увидел терминальный счёт.
;      Меры РЕД. 16:
;      - fdc_recal/fdc_seek очищают fdc_irq6_flag ДО выдачи команды:
;        мгновенное завершение recal (голова уже на треке 0) больше не
;        теряется между выдачей команды и входом в wait_seek_done;
;      - грязный ST0 больше не роняет recal сразу: осушаются до 3
;        дополнительных результатов SENSEI (собственный результат recal
;        мог стоять за чужим — хвост сброса/poll-режима), при неудаче
;        recal повторяется один раз после полного fdc_reset — тот же
;        лог показал: после сброса recal завершается чисто (попытка 2);
;      - фаза данных READ: при таймауте читается остаток счётчика
;        канала 2 DMA; 0xFFFF = TC достигнут, все 512 байт УЖЕ в
;        bounce — данные спасаются ('D'+счётчик), зависшая команда
;        прерывается импульсом RESET, калибровка сбрасывается. Иной
;        остаток = DMA не стартовал — попытка сдаётся как раньше;
;      - fdc_dor_pulse больше не гасит работающий мотор (fdc_motor_up=1):
;        перецикл мотора в recover_bios давал BIOS-чтение сразу после
;        повторного включения мотора — шпиндель не набрал обороты,
;        AH=02 = "not ready";
;      - fdc_recover_bios после перецикла мотора ждёт раскрутку
;        (fdc_spinup) перед осушением/SPECIFY/BIOS-чтением;
;      - fdc_bios_read сам запускает мотор с раскруткой, если флаг
;        fdc_motor_up=0 (защита от "not ready" на любом пути);
;      - маркер 'f' печатает ST0+ST3, маркер 'b' — ST3 опроса SENSE
;        DRIVE STATUS (RDY/DSKCHG/WP): следующий лог железа покажет,
;        ЧТО отвечал чип на recal и ПОЧЕМУ отказал int 13h на FAT.
;
;   13) РЕД. 15 (сессия «Sl>r0af481 r2a — дисковод молчит, лампочка
;      горит» после РЕД. 14; на эмуляторах загрузка идёт). КОРНЕВАЯ
;      ПРИЧИНА: на CS5530 завершение RECALIBRATE/SEEK не ловится
;      опросом SENSE INTERRUPT ВО ВРЕМЯ исполнения команды. Все
;      версии с 14 ноября ловили его ТОЛЬКО так: каждый шаг поллинга
;      шлёт SENSEI, чип отвечает INVALID, и seek-end теряется —
;      'f481' по каждой PIO-попытке с самого дня появления яруса.
;      При этом BIOS на этой машине завершает ТЕ ЖЕ seek'и (stage1
;      читает C0..C2 через int 13h): он ловит сигнал IRQ6, а не
;      опрашивает чип посреди команды. РЕД. 15 переходит на механизм
;      BIOS:
;      - fdc_drv_init ставит СВОЙ обработчик int 0Eh (fdc_irq6_isr:
;        флаг + EOI + iret — без чтений FIFO и без ожиданий,
;        безопасен при любом состоянии чипа, в отличие от
;        обработчика BIOS) и разрешает IRQ6 на весь stage2;
;      - fdc_wait_seek_done ждёт флаг от обработчика, по нему делает
;        ОДИН SENSEI и забирает ST0/PCN; опрос SENSEI/SENSE DRIVE
;        STATUS остался запасным путём (эмуляторы и чипы без IRQ6);
;      - fdc_bios_read на время int 13h возвращает вектор int 0Eh
;        BIOS, а после выхода НЕМЕДЛЕННО (до копирования bounce-
;        буфера) восстанавливает свой вектор и маску IRQ6.
;      Дополнительно (внешний ревью + собственный аудит):
;      - fdc_mot_keep вызывается в fdc_pio_read ПЕРЕД spinup (счётчик
;        0x40:0x40 мог догореть за паузу fdc_motor_cycle — int 08h
;        гасил мотор прямо в раскрутке, recal без шпинделя на
;        CS5530 не завершается, п.12);
;      - fdc_mot_keep в fdc_motor_cycle сразу после выключения мотора;
;      - дедлайн wait_seek_done поднят до 72 тиков (~4 c) на холодный
;        привод, кап итераций до 70;
;      - f12ld.asm держит счётчик мотора сразу после fdc_drv_init;
;      - маркер 'Q' печатает ST0+ST3 на момент сдачи wait_seek_done.
;
;   12) РЕД. 14 (сессия «Sl>r0af481 r2a — дисковод молчит, лампочка
;      горит»). Две причины:
;      (а) ГЛАВНАЯ: дыра в защите мотора. Счётчик motor-off BIOS
;      (0x40:0x40) обновлялся только ПОСЛЕ fdc_reset; на первой
;      попытке в fdc_reset работал счётчик, оставшийся от stage1
;      (уже на исходе): int 08h гасил мотор ПРЯМО ВО ВРЕМЯ spinup,
;      и RECALIBRATE выдавался без шпинделя. Recal на CS5530 без
;      мотора не завершается вовсе: SENSE INTERRUPT вечно INVALID,
;      MSR=0x81 — это и есть повторяющееся 'f481' из всех логов
;      железа (п.8 лечил только ND, но мотор гасил BIOS).
;      Теперь fdc_mot_keep (0x40:0x40=FF + бит мотора юнита в
;      0x40:0x3E) вызывается в начале fdc_reset, перед recal и
;      перед фазой данных READ — мотор защищён на всём пути.
;      (б) Медленный ISA: таймаут fdc_wait_msr считался в единицах
;      по 65535 чтений MSR — на CS5530 одно чтение 0x3F4 занимает
;      единицы-десятки мкс, и «ограниченный» TMO_CMD=60 растягивался
;      на десятки секунд: каждая попытка лестницы могла молчать
;      минутами (симптом «молчит, лампочка горит, ничего не
;      происходит»). Единица уменьшена до 2048 чтений (~1-40 мс),
;      константы пересчитаны: байтовые ожидания ~10-300 мс,
;      фазовые ~0.5-6 с. Худший путь лестницы теперь даёт
;      'F'-дамп за десятки секунд, а не за часы.
;      Дополнительно: у fdc_wait_idle итерационный кап получил реальную
;      цену (2 мс на итерацию — кап = ~0.6 с, а не микросекунды);
;      на каждой эскалированной попытке печатается НОМЕР ФАЗЫ при
;      её начале ('1'..'9') — следующий висяк на железе укажет
;      маркером, в какой именно фазе он случился.
;
; Диагностика (COM/экран):
;   '>' — начало bpb_init; 'a' — fdc_reset прошёл;
;   'b'/'c' —
;   recalibrate/seek прошли (только когда лестница поднималась);
;   'f'+фаза+MSR+ST0+ST3 — PIO-попытка не удалась (РЕД. 16: ST0/ST3 —
;         последний ответ SENSEI/SENSE DRIVE STATUS: грязный recal
;         виден сразу, а не только факт отказа);
;   'b'+AH+ST3 — BIOS-попытка не удалась; ST3 — опрос SENSE DRIVE
;         STATUS после провала (бит 5 = RDY, бит 6 = WP,
;         бит 7 = DSKCHG); '??' = чип не принял опрос;
;   'D'+счётчик CH2 — фаза данных READ спасена по TC: все 512 байт
;         прошли DMA, чип не увидел терминальный счёт (РЕД. 16);
;   'B'+hex(C) — начало BIOS-попытки при поднятой лестнице (атрибуция висяков внутри int 13h);
;   'L'+шаг — выполнено действие лестницы (2..7);
;   'r'+код скорости — ротация скоростей PIO;
;   'F'+фаза+ST0 ST1 ST2+'M'+MSR — финальный дамп после лестницы;
;   'Q'+ST0+ST3 — wait_seek_done сдался по дедлайну (тик- или
;         итерационному): ST0 — последний ответ SENSEI (0x80 =
;         завершение seek так и не пришло), ST3 — последний SENSE
;         DRIVE STATUS (бит 0x10 = T0, голова на треке 0);
;   '1'..'9' — начало фазы (fdc_ph) на ЭСКАЛИРОВАННОЙ попытке
;         (лестница выше шага 0): 1=готовность, 2=SPECIFY,
;         3=SENSE INT, 4=RECAL, 5=SEEK, 6=команда READ, 7=фаза
;         данных, 8=результаты, 9=проверка; печать ДО фазы —
;         последний напечатанный номер в висячем логе = фаза,
;         в которой машина застряла;
;   ('T'/'d' упразднены РЕД. 12: ND-поллинг фазы данных заменён DMA);
;   'V' — верификация кластера поймала порчу (два чтения разны);
;   'N'+hex+дамп — fat12_find_file не нашёл файл;
;   'Z' — корневой каталог перечитан;
;   'W'/'X'/'Y'/'0'-'4' — вехи f12ld.asm_;
;   'e'+ "Disk error" — чтение не удалось вовсе.
;
;Коды фаз: 1=готовность после reset, 2=SPECIFY, 3=SENSE INT, 4=RECALIBRATE, 5=SEEK,
;6=команда READ, 7=фаза данных, 8=фаза результатов, 9=проверка.
;
;ВНИМАНИЕ: запись в DSR (0x3F4 на запись) по-прежнему запрещена:
;на TA-NC529/CS5530 сборка с ней умирала молча сразу после 'r0'.
;Скорость задаём только через CCR (0x3F7).


BITS 16

FDC_DOR     equ 0x3F2           ; Digital Output Register
FDC_MSR     equ 0x3F4           ; Main Status Register (чтение)
                                ; (запись в 0x3F4 = DSR — ЗАПРЕЩЕНА,
                                ;  см. шапку)
FDC_FIFO    equ 0x3F5           ; FIFO / данные
FDC_CCR     equ 0x3F7           ; скорость передачи (запись)

;============================================================
;FDC_IOWAIT — задержка восстановления шины I/O (~1-2 мкс).
;На реальном железе (Geode GX1 + CS5530) чтение MSR сразу после записи в FIFO возвращает старое
;значение RQM. Запись в порт 0x80 (POST) безвредна и занимает полный цикл ISA-шины.
;============================================================
%macro FDC_IOWAIT 0
    out 0x80, al
    out 0x80, al
%endmacro

;============================================================
;FDC_ACKRQM — подтверждение приема/выдачи байта FIFO.
;После каждого обмена с FIFO контроллер должен СНЯТЬ бит RQM (латентность сотни нс — единицы мкс).
;Ждём фактического сброса RQM (с ограничением числа итераций).
;Макрос портит AL, сохраняет CX/DX сам.
;============================================================
%macro FDC_ACKRQM 0
    ; ВНИМАНИЕ (РЕД. 14): CF здесь НЕ выставляется. Окно снятия RQM
    ; между байтами короче шага поллинга (проверено в QEMU: MSR все
    ; 2000 опросов держит 0x90 при фактически принятом байте):
    ; «честная» проверка отвергала ПРИНЯТЫЕ байты и ломала все
    ; команды ('f200' по каждой попытке). Факт непринятия байта
    ; выявляют фазовые таймауты следующей команды (маркеры
    ; '1'..'9' + 'f'+фаза+MSR).
    push cx
    push dx
    mov  dx, FDC_MSR
    mov  cx, 2000
%%.ack:
    in   al, dx
    test al, 0x80               ;RQM ещё поднят?
    loopnz %%.ack               ;крутим, пока RQM=1 и не исчерпан лимит
    FDC_IOWAIT
    pop  dx
    pop  cx
%endmacro

MSR_RQM     equ 0x80            ;готов к обмену байтом
MSR_DIO     equ 0x40            ;1 = FDC -> CPU

;Таймауты: единица = 2048 чтений MSR (РЕД. 14: было 65535). Чтение
; ISA-порта на CS5530 ~1-20 мкс => единица ~ 2-40 мс (на эмуляторах
; ~1-2 мс). Старая шкала делала «ограниченные» ожидания на реальном
; железе десятками секунд (TMO_CMD=60 ~ десятки секунд, ladder
; молчал минутами); новая даёт худший таймаут фазы ~6 с.
TMO_CMD     equ 150             ;фаза данных/результатов READ ~0.3-6 c
TMO_READY   equ 150             ;готовность после reset ~0.3-6 c
TMO_BYTEC   equ 8               ;байт командной/результирующей фазы
                                ; ~16-320 мc (чип принимает байт за мкс)

;Коды фаз для диагностики
PH_READY    equ 1
PH_SPECIFY  equ 2
PH_SENSED   equ 3
PH_RECAL    equ 4
PH_SEEK     equ 5
PH_READCMD  equ 6
PH_DATA     equ 7
PH_RESULT   equ 8
PH_VERIFY   equ 9

;--- переменные драйвера ---
fdc_unit        db 0            ;номер устройства (drive & 3)
fdc_motor_up    db 0            ;мотор раскручен
fdc_calibrated  db 0            ;позиция головки известна
fdc_cyl_cur     db 0xFF         ;текущий цилиндр (0xFF = неизвестен)
fdc_ph          db 0            ;текущая фаза (диагностика)
fdc_st0         db 0
fdc_st1         db 0
fdc_st2         db 0
fdc_msr_last    db 0            ; MSR на момент последнего таймаута
fdc_rc          db 0            ; результат: C
fdc_rr          db 0            ; результат: R
fdc_C           db 0            ; целевые C/H/R
fdc_H           db 0
fdc_R           db 0
fdc_stmp        db 0            ; целевой цилиндр для seek
fdc_pic         db 0            ; сохранённая маска PIC
fdc_irq6_flag   db 0            ; 1 = IRQ6 пойман нашим обработчиком
                                ;     int 0Eh (РЕД. 15)
fdc_st3         db 0            ; последний SENSE DRIVE STATUS (диагн.)
fdc_bios_e0     dw 0            ; офсет вектора int 0Eh BIOS
                                ;     (временно возвращается BIOS-ярусу)
fdc_bios_e2     dw 0            ; сегмент вектора int 0Eh BIOS
fdc_probed      db 0            ; щуп шины 0x3F4 уже делали
fdc_pio_dead    db 0            ; 1 = FDC не декодируется (шина 0xFF):
                                ;     PIO-ярус запрещён, читаем BIOS
fdc_tier        db 1            ; ТЕКУЩИЙ ЯРУС: 1 = PIO (ПЕРВИЧНЫЙ!);
                                ;             0 = BIOS (фолбэк лестницы).
                                ; ПОЧЕМУ PIO ПЕРВЫЙ (п.9 шапки): на
                                ; TA-NC529 BIOS AH=02 зависает навсегда
                                ; (ждёт IRQ6 без таймаута) на первом же
                                ; чтении ДАЛЬНЕГО цилиндра; PIO целиком
                                ; ограничен таймаутами и висеть не может
fdc_tier_ok     db 0xFF         ; РЕД. 11: ярус, ПОСЛЕДНИМ УСПЕШНО читавший
                                ;             сектор (0 = BIOS, 1 = PIO, 0xFF =
                                ;             не определён). Держит лестницу на
                                ;             доказанном ярусе: 86box рвёт PIO-
                                ;             фазу данных (ND=1) после 1-го байта
                                ;             (T0001 + ST0=40 ST1=10 ND), BIOS
                                ;             честный — а лестница после
                                ;             исчерпания ВСЕГДА возвращалась на
                                ;             PIO и XOR-ом на шагах 4/7 могла
                                ;             свалиться обратно; кластеры
                                ;             FB_DR.DRV гибли, "Disk error".
fdc_step        db 0            ; шаг лестницы 0..7 (живёт между
                                ;     секторами, спускается на 1 при
                                ;     успехе)
fdc_escalated   db 0            ; 1 = лестница поднималась: включить
                                ;     пошаговую трассировку 'b'/'c'
fdc_bios_ah     db 0            ; AH последней BIOS-попытки (диагн.)
fdc_inited      db 0            ; контроллер уже переведён в наш режим
fdc_ccr         db 0x00         ; код скорости: 0=500 кбит/с, 2=250,
                                ;              1=300 (привод 1.2М)
fdc_ccr_force   db 1            ; 1 = программируем CCR при каждом reset
fdc_ccr_known   db 0            ; 1 = скорость подтверждена (BPB
                                ;     разобран); пока 0 — PIO ротирует
fdc_rate_idx    db 0            ; индекс ротации скоростей PIO
fdc_pio_proven  db 0            ; 1 = PIO-попытка УДАЛАСЬ при ротации:
                                ;     её скорость (fdc_ccr) доказана
                                ;     железом и не переопределяется BPB
                                ;     (привод 1.2М + дискета 720К:
                                ;     факт 300 кбит/с, BPB говорит 250)
fdc_dst_seg     dw 0            ; приёмник сектора
fdc_dst_off     dw 0
fdc_vlba        dw 0            ; LBA первого сектора кластера (вериф.)
fdc_vcur        dw 0            ; текущий LBA при верификации
fdc_vseg        dw 0            ; сегмент приёмника при верификации

; скорости ротации PIO (CCR-коды): 500 -> 250 -> 300 кбит/с
fdc_rates       db 0x00, 0x02, 0x01

; ---------------------------------------------------------------
; fdc_mot_keep: держать мотор с точки зрения BIOS. Счётчик
; motor-off 0x40:0x40 = 0xFF (int 08h не погасит) и бит мотора
; юнита в 0x40:0x3E выставлен. РЕД. 14: без этого int 08h гасил
; мотор во время fdc_reset/spinup/recal первой попытки (счётчик
; от stage1 уже догорал), RECALIBRATE без шпинделя на CS5530
; не завершается ('f481' в логе железа). Все регистры сохраняет.
; ---------------------------------------------------------------
fdc_mot_keep:
        push ax
        push cx
        push ds
        mov ax, 0x0040
        mov ds, ax
        mov byte [0x0040], 0xFF     ;счётчик motor-off = макс
        mov cl, [cs:fdc_unit]
        mov ah, 0x80
        shr ah, cl                  ;бит мотора юнита (0->0x80, 1->0x40)
        or  [0x003E], ah            ;BIOS знает, что мотор включён
        pop ds
        pop cx
        pop ax
        ret

; ---------------------------------------------------------------
; fdc_ph_mark: печать цифры текущей фазы (fdc_ph) ТОЛЬКО на
; эскалированных попытках (fdc_step>0 или лестница поднималась).
; РЕД. 14: висячий лог железа с последней напечатанной цифрой
; указывает фазу, в которой машина застряла. Все регистры сохраняет.
; ---------------------------------------------------------------
fdc_ph_mark:
        cmp byte [cs:fdc_step], 0
        jne .pm_go
        cmp byte [cs:fdc_escalated], 0
        je  .pm_ret
.pm_go:
        pusha
        mov al, [cs:fdc_ph]
        add al, '0'
        call debug_char
        popa
.pm_ret:
        ret

; ------------------------------------------------------------
; fdc_drv_init: вызвать один раз при старте stage2
; РЕД. 13: кроме номера устройства — маскирует IRQ6 на весь
; остаток stage2. PIO-ярус работает поллингом и в прерывании
; не нуждается; главное — обработчик int 0Eh BIOS не должен
; запускаться против нашего самодельного состояния чипа
; (зависший recal, самодельные сбросы): он ждёт фазу результатов
; без таймаута и выполняется с IF=0 — тики останавливаются,
; мотор перестаёт гаситься, машина умирает молча. Разрешение
; IRQ6 только вокруг int 13h (fdc_bios_read).
; ------------------------------------------------------------
fdc_drv_init:
        pusha
        mov al, [cs:drive]
        and al, 0x03
        mov [cs:fdc_unit], al
        ; запомнить вектор int 0Eh BIOS: BIOS-ярус временно возвращает
        ; его на время int 13h (fdc_bios_read)
        push ds
        xor ax, ax
        mov ds, ax
        mov ax, [0x0038]
        mov [cs:fdc_bios_e0], ax
        mov ax, [0x003A]
        mov [cs:fdc_bios_e2], ax
        ; свой обработчик IRQ6 (РЕД. 15): ставит флаг, EOI, iret.
        ; Никаких чтений FIFO и ожиданий — безопасен при ЛЮБОМ
        ; состоянии чипа: обработчик BIOS на самодельных состояниях
        ; ждёт фазу результатов без таймаута с IF=0 и вешает машину
        ; (п.11в). IRQ6 разрешён на весь stage2 — завершение
        ; seek/recal/read ловится сигналом, как у BIOS
        pushf
        cli
        mov word [0x0038], fdc_irq6_isr
        mov [0x003A], cs
        in  al, 0x21
        mov [cs:fdc_pic], al    ; исходная маска (на будущее)
        and al, 0xBF
        out 0x21, al            ; IRQ6 ловит наш обработчик
        popf
        pop ds
        popa
        ret

; ------------------------------------------------------------
; fdc_irq6_isr: обработчик int 0Eh (IRQ6), РЕД. 15. Фиксирует факт
; прерывания (fdc_irq6_flag=1) и даёт EOI. Разбор результата
; (SENSEI с ST0/PCN) делает fdc_wait_seek_done в основном контексте:
; обработчик не должен трогать FIFO — чип может быть в любой фазе
; любой команды (это и вешало обработчик BIOS). Ложные/чужие
; прерывания безопасны: флаг разбирается через SENSEI, INVALID
; просто пропускается.
; ------------------------------------------------------------
fdc_irq6_isr:
        push ax
        mov byte [cs:fdc_irq6_flag], 1
        mov al, 0x20
        out 0x20, al            ; nonspecific EOI, мастер-контроллер
        pop ax
        iret

; ------------------------------------------------------------
; fdc_bios_arm: вернуть вектор int 0Eh BIOS и разрешить IRQ6 —
; подготовка int 13h (его обработчик сам разбирает своё прерывание).
; cli держится до конца подмены: IRQ6 в окне подмены вектора ушёл бы
; на полу-подменённый адрес. Регистры и флаги не портит.
; ------------------------------------------------------------
fdc_bios_arm:
        push ax
        push ds
        pushf
        cli
        xor ax, ax
        mov ds, ax
        mov ax, [cs:fdc_bios_e0]
        mov [0x0038], ax
        mov ax, [cs:fdc_bios_e2]
        mov [0x003A], ax
        in  al, 0x21
        and al, 0xBF            ; IRQ6 разрешён только на время int 13h
        out 0x21, al
        popf
        pop ds
        pop ax
        ret

; ------------------------------------------------------------
; fdc_bios_rearm: вернуть свой вектор int 0Eh и маску IRQ6 — сразу
; после возврата из int 13h, ДО копирования bounce-буфера и любых
; действий с чипом: застрявшее прерывание не должно уходить в
; обработчик BIOS против самодельного состояния чипа (п.11в).
; Регистры и флаги не портит (CF от int 13h проходит насквозь).
; ------------------------------------------------------------
fdc_bios_rearm:
        push ax
        push ds
        pushf
        cli
        xor ax, ax
        mov ds, ax
        mov word [0x0038], fdc_irq6_isr
        mov [0x003A], cs
        in  al, 0x21
        or  al, 0x40            ; IRQ6 под маской вне BIOS-яруса
        out 0x21, al
        popf
        pop ds
        pop ax
        ret

; ============================================================
; fdc_read_lba: ГЛАВНЫЙ ВХОД. AX = LBA, ES:BX = приёмник.
; CF=0 при успехе. Все регистры сохраняются.
; Заменяет BIOS int 13h AH=02. Держит лестницу из 8 шагов:
; см. шапку. Состояние лестницы (fdc_step, fdc_tier) живёт между
; вызовами: успех на шаге N спускает на N-1, полная неудача
; возвращает лестницу на шаг 0 и BIOS-ярус для следующего сектора.
; ============================================================
fdc_read_lba:
        pusha
        push ds
        push es

        ; LBA -> CHS (геометрия из BPB, заполненного bpb_init)
        xor dx, dx
        div word [cs:spt]       ; AX = трек, DX = сектор-1
        inc dx
        mov [cs:fdc_R], dl
        xor dx, dx
        div word [cs:heads]     ; AX = цилиндр, DX = головка
        mov [cs:fdc_H], dl
        mov [cs:fdc_C], al

        mov [cs:fdc_dst_seg], es
        mov [cs:fdc_dst_off], bx

        ; Одноразовый щуп шины 0x3F4: два чтения подряд возвращают
        ; 0xFF — легаси-FDC не декодируется (CF-18/USB-FDD и т.п.).
        ; Это лишь ЗАПРЕЩАЕТ PIO-ярус: BIOS-ярус работает всегда.
        cmp byte [cs:fdc_probed], 0
        jne .probe_done
        mov byte [cs:fdc_probed], 1
        mov dx, FDC_MSR
        in  al, dx
        mov bl, al
        in  al, dx
        cmp al, bl
        jne .probe_done         ; значение дрожит — FDC живой
        cmp al, 0xFF
        jne .probe_done
        mov byte [cs:fdc_pio_dead], 1
.probe_done:

        ; ---------------- ЛЕСТНИЦА (8 шагов) ----------------
.step:
        mov al, [cs:fdc_step]
        ; 0,1,5 — чистая попытка; 2,4,7 — восстановление/смена;
        ; 3,6 — цикл мотора + восстановление
        test al, al
        jz  .try
        cmp al, 1
        je  .try
        cmp al, 5
        je  .try
        cmp al, 2
        je  .recov
        cmp al, 6
        je  .motor_recov
        cmp al, 3
        je  .motor_recov
        ; шаги 4 и 7: смена яруса — ТОЛЬКО пока ярусы не проверены.
        ; РЕД. 11: если текущий ярус уже доказан (совпадает с
        ; fdc_tier_ok), шаг сводится к восстановлению БЕЗ смены яруса:
        ; XOR больше не сбрасывает лестницу с работающего яруса на
        ; мёртвый (86box: PIO рвётся в фазе данных; TA-NC529: BIOS
        ; зависает на дальних цилиндрах без таймаута).
        mov byte [cs:fdc_escalated], 1
        cmp byte [cs:fdc_pio_dead], 0
        jne .sw_stay_bios       ; PIO запрещён — BIOS и только BIOS
        mov al, [cs:fdc_tier]
        cmp al, [cs:fdc_tier_ok]
        je  .sw_keep            ; текущий ярус доказан — не меняем
        xor byte [cs:fdc_tier], 1
.sw_keep:
        pusha
        mov al, 'L'
        call debug_char
        mov al, [cs:fdc_step]
        add al, '0'
        call debug_char
        mov al, ' '
        call debug_char
        popa
        call fdc_recover_cur    ; подготовка (нового) яруса
        jmp .try
.sw_stay_bios:
        mov byte [cs:fdc_tier], 0
        jmp .sw_keep
.motor_recov:
        mov byte [cs:fdc_escalated], 1
        pusha
        mov al, 'L'
        call debug_char
        mov al, [cs:fdc_step]
        add al, '0'
        call debug_char
        mov al, ' '
        call debug_char
        popa
        call fdc_motor_cycle
        call fdc_recover_cur
        jmp .try
.recov:
        mov byte [cs:fdc_escalated], 1
        pusha
        mov al, 'L'
        call debug_char
        mov al, [cs:fdc_step]
        add al, '0'
        call debug_char
        mov al, ' '
        call debug_char
        popa
        call fdc_recover_cur
        ; jmp .try
.try:
        cmp byte [cs:fdc_tier], 0
        jne .try_pio
        call fdc_bios_read      ; ЯРУС BIOS
        jmp .tried
.try_pio:
        ; FDC не декодируется (шина 0xFF, USB-FDD/CF-18)? PIO-ярус
        ; мгновенно мёртв — не жжём 4 шага лестницы на таймаутах,
        ; читаем BIOS сразу
        cmp byte [cs:fdc_pio_dead], 0
        je  .tp_real
        mov byte [cs:fdc_tier], 0
        call fdc_bios_read
        jmp .tried
.tp_real:
        call fdc_pio_read       ; ЯРУС PIO
.tried:
        jnc .ok
        ; --- диагностика неудавшейся попытки ---
        pusha
        cmp byte [cs:fdc_tier], 0
        jne .dbg_pio
        mov al, 'b'             ; BIOS: 'b' + код AH от int 13h
        call debug_char
        mov al, [cs:fdc_bios_ah]
        call screen_hex_byte
        ; РЕД. 16: опрос SENSE DRIVE STATUS после BIOS-провала — ST3
        ; показывает ПОЧЕМУ int 13h отказал: бит 5 = RDY (привод готов),
        ; бит 6 = WP, бит 7 = DSKCHG (смена дискеты). '??' = чип не
        ; принял опрос (команда ещё исполняется)
        mov bl, 0x04
        call fdc_out
        jc  .dbg_nosts
        mov bl, [cs:fdc_H]
        shl bl, 2
        or  bl, [cs:fdc_unit]
        call fdc_out
        jc  .dbg_nosts
        call fdc_in
        jc  .dbg_nosts
        mov [cs:fdc_st3], bl
        mov al, bl
        call screen_hex_byte
        jmp .dbg_sts_done
.dbg_nosts:
        mov al, '?'
        call debug_char
        mov al, '?'
        call debug_char
.dbg_sts_done:
        mov al, ' '
        call debug_char
        jmp .dbg_done
.dbg_pio:
        mov al, 'f'             ; PIO: 'f' + фаза + MSR + ST0 + ST3
        call debug_char         ; РЕД. 16: грязный результат recal виден
        mov al, [cs:fdc_ph]     ; сразу ('f4 81 60 30' = IC=01+SE, ST3
        add al, '0'             ; RDY/T0), а не только факт отказа
        call debug_char
        mov al, [cs:fdc_msr_last]
        call screen_hex_byte
        mov al, [cs:fdc_st0]
        call screen_hex_byte
        mov al, [cs:fdc_st3]
        call screen_hex_byte
        mov al, ' '
        call debug_char
.dbg_done:
        popa
        inc byte [cs:fdc_step]
        cmp byte [cs:fdc_step], 8
        jb  .step
        ; --- лестница исчерпана: финальный дамп состояния FDC ---
        ; (печатаем ДО каких-либо сбросов: они затирают фазу)
        pusha
        push ds
        push es
        mov al, 'F'
        call debug_char
        mov al, [cs:fdc_ph]
        add al, '0'
        call debug_char
        mov al, ' '
        call debug_char
        mov al, [cs:fdc_st0]
        call screen_hex_byte
        mov al, [cs:fdc_st1]
        call screen_hex_byte
        mov al, [cs:fdc_st2]
        call screen_hex_byte
        mov al, ' '
        call debug_char
        mov al, 'M'
        call debug_char
        mov al, [cs:fdc_msr_last]
        call screen_hex_byte
        mov al, ' '
        call debug_char
        pop es
        pop ds
        popa
        call fdc_reset          ; снять хвосты, вернуть в покой
        ; РЕД. 11: лестница для СЛЕДУЮЩЕГО сектора начинается с ЯРУСА,
        ; который последним успешно читал (fdc_tier_ok), а не с PIO
        ; всегда: доказанный BIOS-ярус больше не вымучивается заново
        ; четырьмя PIO-попытками (две из них — циклы мотора по ~1-2.5 c).
        ; Пока ярусы не проверены (0xFF) — как раньше, с PIO (первичный).
        mov byte [cs:fdc_step], 0
        mov al, [cs:fdc_tier_ok]
        cmp al, 0xFF
        je  .exh_pio
        mov [cs:fdc_tier], al
        jmp .exh_done
.exh_pio:
        mov byte [cs:fdc_tier], 1
.exh_done:
        stc
        jmp .ret
.ok:
        ; МЯГКИЙ СПУСК ПО ЛЕСТНИЦЕ (CF выставляем В КОНЦЕ — cmp ниже
        ; портит флаги!). Спуск НЕ должен проеезжать через «дорогие»
        ; шаги (2 = восстановление, 3/6 = цикл мотора с паузой ~1-2.5 с,
        ; 4/7 = смена яруса) — иначе после одной эскалации КАЖДЫЙ
        ; сектор возил бы мотор туда-сюда (на ядре в сотни секторов
        ; это часы). Правила:
        ;   0,1 -> 0   (быстрый путь);
        ;   2   -> 1   (восстановление помогло — следующая попытка чистая);
        ;   3..7 -> 5  (работает НЕ-bios/восстановленный путь — остаются
        ;               ЧИСТЫЕ попытки текущего яруса; при очередном сбое
        ;               лестница снова пойдёт вверх с 6-го шага).
        mov al, [cs:fdc_step]
        cmp al, 2
        jb  .ok_ret              ; 0,1 — остаёмся на быстром пути
        je  .ok_step2
        mov byte [cs:fdc_step], 5
        jmp .ok_ret
.ok_step2:
        mov byte [cs:fdc_step], 1
.ok_ret:
        ; РЕД. 11: запомнить, КАКОЙ ярус читал (fdc_tier уже указывает
        ; на использованный: fdc_bios_read/fdc_pio_read его не меняют,
        ; а .try_pio при pio_dead ставит 0 до BIOS-чтения).
        mov al, [cs:fdc_tier]
        mov [cs:fdc_tier_ok], al
        clc                      ; успех: CF=0
.ret:
        pop es
        pop ds
        popa
        ret

; ------------------------------------------------------------
; fdc_recover_cur: восстановление ТЕКУЩЕГО яруса.
; BIOS  -> fdc_recover_bios (полная реанимация DMA-режима);
; PIO   -> fdc_reset (сброс + SPECIFY ND=0 + CCR + мотор).
; ------------------------------------------------------------
fdc_recover_cur:
        cmp byte [cs:fdc_tier], 0
        jne .rc_pio
        call fdc_recover_bios
        ret
.rc_pio:
        call fdc_reset
        ret

; ------------------------------------------------------------
; fdc_pio_read: ОДНА PIO-попытка чтения сектора fdc_C/H/R в
; fdc_dst_seg:off. CF=0 при успехе. Маскирует IRQ6 только на время
; операции (BIOS-ярус НЕ маскируется никогда: int 13h сам ждёт
; IRQ6). Пока скорость не подтверждена (fdc_ccr_known=0), ротирует
; 500/250/300 кбит/с по попыткам с форс-ресетом.
; ------------------------------------------------------------
fdc_pio_read:
        pusha
        push ds
        push es

        ; ротация скоростей, пока не подтверждена (щуп из bpb_init
        ; удалён: он отравлял контроллер до первого BIOS-чтения)
        cmp byte [cs:fdc_ccr_known], 0
        jne .rate_ok
        mov al, [cs:fdc_rate_idx]
        inc byte [cs:fdc_rate_idx]
        and al, 3
        cmp al, 3
        jb  .ri_ok
        xor al, al
.ri_ok:
        mov bx, ax
        mov al, [cs:fdc_rates+bx]
        mov [cs:fdc_ccr], al
        mov byte [cs:fdc_inited], 0     ; форсировать fdc_reset
        pusha
        mov al, 'r'
        call debug_char
        mov al, [cs:fdc_ccr]
        add al, '0'             ; '0'/'2'/'1' — как в старых маркерах
        call debug_char
        popa
.rate_ok:
        ; РЕД. 15: IRQ6 разрешён на весь stage2 и ловится собственным
        ; обработчиком fdc_irq6_isr (fdc_drv_init); флаг завершения
        ; разбирает fdc_wait_seek_done. Обработчик BIOS никогда не
        ; выполняется против наших состояний чипа (п.11в шапки) —
        ; его вектор временно возвращается только вокруг int 13h
        ; (fdc_bios_read).

        ; контроллер уже в нашем режиме?
        cmp byte [cs:fdc_inited], 0
        jne .inited
        call fdc_reset
        mov byte [cs:fdc_inited], 1
        jc  .fail
        pusha
        mov al, 'a'             ; reset прошёл (всегда — редко бывает)
        call debug_char
        popa
        jmp .motor
.inited:
.motor:
        ; мотор: состояние — только по своему флагу (чтение DOR на
        ; CS5530 возвращает мусор)
        cmp byte [cs:fdc_motor_up], 0
        jne .motor_ok
        call fdc_mot_keep       ; РЕД. 15: счётчик 0x40:0x40 мог догореть
                                ; за паузу motor_cycle/recovery — int 08h
                                ; гасил мотор прямо в раскрутке, recal
                                ; без шпинделя не завершался ('f481', п.12)
        call fdc_dor_motor
        mov dx, FDC_DOR
        out dx, al
        call fdc_spinup
        mov byte [cs:fdc_motor_up], 1
.motor_ok:
        ; BIOS-обработчик int 08h гасит мотор, когда истекает счётчик
        ; 0x40:0x40 (до ~14 с от 0xFF): его запись в DOR УБИВАЕТ нашу
        ; команду посреди фазы данных. Пока PIO-ярус жив, счётчик
        ; держим максимальным — так же делает fdc_bios_read.
        ; РЕД. 14: обновляется и бит мотора в 0x40:0x3E (fdc_mot_keep)
        call fdc_mot_keep
        ; калибровка (если позиция головки неизвестна)
        cmp byte [cs:fdc_calibrated], 0
        jne .cal_ok
        call fdc_recal
        jc  .fail
        mov bl, 'b'
        call fdc_trace
.cal_ok:
        ; seek, если цилиндр не тот
        mov al, [cs:fdc_C]
        cmp al, [cs:fdc_cyl_cur]
        je  .seek_ok
        mov bl, al
        call fdc_seek
        jc  .fail
        mov bl, 'c'
        call fdc_trace
.seek_ok:
        call fdc_mot_keep       ; РЕД. 14: обновить счётчик мотора перед
                                ; фазой данных — долгие таймауты на
                                ; медленной шине не оставляют BIOS шанса
                                ; погасить мотор посреди READ
        call fdc_read_op
        jc  .fail
        mov byte [cs:fdc_pio_proven], 1 ; скорость PIO доказана фактом
        jmp .done
.fail:
        stc
.done:
        ; РЕД. 13: маска PIC не трогается (п.11в шапки); CF прошёл
        ; через popa без изменений
        pop es
        pop ds
        popa
        ret

; ------------------------------------------------------------
; fdc_trace: печать маркера шага (BL = символ) — ТОЛЬКО когда
; лестница поднималась (fdc_escalated=1): в нормальной загрузке
; трасса молчит, при проблемах — виден каждый шаг.
; ------------------------------------------------------------
fdc_trace:
        cmp byte [cs:fdc_escalated], 0
        je  .tr_ret
        push ax
        mov al, bl
        call debug_char
        pop ax
.tr_ret:
        ret

; ------------------------------------------------------------
; fdc_dor_pulse: импульс RESET через DOR — прерывает ЛЮБУЮ
; зависшую команду (stuck seek/recal/read). Оставляет контроллер
; с RESET=1, мотором юнита и IRQ/DMA-разрешением; флаг мотора
; сброшен (раскрутку делает вызывающий ярус: PIO — fdc_spinup,
; BIOS — сам внутри int 13h).
; ------------------------------------------------------------
fdc_dor_pulse:
        push ax
        push cx
        push dx
        mov al, [cs:fdc_unit]
        or  al, 0x08            ; RESET=0 — контроллер в сбросе
        ; РЕД. 16: если шпиндель уже раскручен (fdc_motor_up=1), мотор
        ; НЕ гасим на время импульса: раньше recover_bios каждый раз
        ; перецикливал мотор (выкл -> вкл без раскрутки), и следующее
        ; BIOS-чтение уходило в "not ready" — дискета не успевала
        ; набрать обороты за миллисекунды между включением и AH=02
        cmp byte [cs:fdc_motor_up], 0
        je  .dp_out
        mov cl, [cs:fdc_unit]
        mov ah, 0x10
        shl ah, cl
        or  al, ah              ; мотор юнита остаётся включённым
.dp_out:
        mov dx, FDC_DOR
        out dx, al
        FDC_IOWAIT
        call fdc_delay_2ms
        call fdc_dor_motor      ; RESET=1 + мотор юнита
        mov dx, FDC_DOR
        out dx, al
        FDC_IOWAIT
        cmp byte [cs:fdc_motor_up], 0
        jne .dp_keep            ; РЕД. 16: мотор не гасился — флаг не сбрасываем
        mov byte [cs:fdc_motor_up], 0
.dp_keep:
        pop dx
        pop cx
        pop ax
        ret

; ------------------------------------------------------------
; fdc_wait_idle: лучший из возможных (best-effort) ожидатель покоя —
; (MSR & 0xF0) == 0x80: RQM=1, DIO=0, NDM=0, CB=0; биты ACT игнорируются,
; потому что после RESET включается режим ПОЛЛИНГА, и на реальных чипах
; MSR легитимно висит на 0x81 (ACT юнита) без всякой застрявшей команды.
; Гарантию отсутствия команд даёт НЕ эта проверка, а предшествующий
; импульс RESET в DOR (fdc_dor_pulse) — он прерывает всё. Дедлайн —
; 36 тиков BIOS (~2 c). CF=0 — покой; CF=1 — таймаут.
; ------------------------------------------------------------
fdc_wait_idle:
        push ax
        push cx
        push dx
        push si
        push di                 ; РЕД. 13: DI = счётчик итераций
        push ds
        mov ax, 0x0040
        mov ds, ax
        mov cx, [0x006C]        ; стартовый тик BIOS
        xor ax, ax
        mov ds, ax
        mov dx, FDC_MSR
        mov di, 300             ; итерационный кап: выход гарантирован
                                ; даже при стоящем счётчике тиков
.wi_poll:
        dec di
        jz  .wi_quota
        in  al, dx
        mov ah, al
        and ah, 0xF0            ; RQM|DIO|NDM|CB (ACT игнорируем)
        cmp ah, 0x80
        je  .wi_ok
        push ax
        mov ax, 0x0040
        mov ds, ax
        mov si, [0x006C]
        xor ax, ax
        mov ds, ax
        sub si, cx              ; прошло тиков (word-wrap безопасен)
        pop ax
        cmp si, 36              ; ~2 c
        jb  .wi_delay
        mov [cs:fdc_msr_last], al
        stc
        jmp .wi_ret
.wi_delay:
        ; РЕД. 14: реальная цена итерации (~2 мс) — иначе итерационный
        ; кап 300 выгорал за микросекунды и wait_idle «не ждал» вовсе
        push ax
        push bx
        call fdc_delay_2ms
        pop bx
        pop ax
        jmp .wi_poll
.wi_quota:
        ; тик-дедлайн не сработал (int 08h не тикает): после капа
        ; итераций фиксируем последний MSR и выходим с CF=1 —
        ; вызыватель обработает как «покой не подтверждён»
        mov [cs:fdc_msr_last], al
        stc
        jmp .wi_ret
.wi_ok:
        clc
.wi_ret:
        pop ds
        pop di
        pop si
        pop dx
        pop cx
        pop ax
        ret

; ------------------------------------------------------------
; fdc_recover_bios: ПОЛНАЯ реанимация контроллера перед BIOS-ярусом
; после любых PIO-экспериментов (или зависших команд).
;   1) импульс RESET в DOR — прервать stuck-команду;
;   2) дождаться покоя MSR==0x80 (до ~2 c; при таймауте — второй
;      импульс RESET и снова ожидание);
;   3) осушить очередь SENSE INTERRUPT (до 4 байтов);
;   4) SPECIFY с ND=0 — байты ГАРАНТИРОВАННО приняты, чип в покое;
;   5) скорость (CCR) — только если BPB уже подтверждён;
;   6) счётчик мотора BIOS 0x40:0x40 = 0xFF (не гасить мотор);
;   7) РЕД. 12: int 13h AH=00 исключён — BIOS ждёт IRQ6 без таймаута
;      и виснет после наших PIO-экспериментов (лог: после 'L4' ни
;      маркера 'B', ни 'F'-дампа — висяк до BIOS-чтения). Состояние
;      BIOS синхронизируется вручную: кэш цилиндра 0x94/95 = 0,
;      recal-pending биты 0x3E (0-1) сброшены — иначе BIOS AH=02
;      запустил бы СВОЙ recal с тем же вечным ожиданием IRQ6, бит
;      мотора юнита в 0x3E выставлен (мотор уже крутит);
;   8) кэш цилиндра BIOS 0x40:0x94/0x95 = 0 (наши RESET/recal сбили
;      представление BIOS о позиции головки — без этого BIOS пропускал
;      seek и читал «не там»; в связке с fix в fdc_bios_read старых
;      версий это выглядело как AH=01 на цилиндрах >= 4).
; CF не возвращает: восстановление — лучшее из возможного; вердикт
; даст сама BIOS-попытка.
; ------------------------------------------------------------
fdc_recover_bios:
        push ax
        push cx
        push dx
        push ds
        call fdc_dor_pulse
        cmp byte [cs:fdc_motor_up], 0
        jne .rb_spun
        ; РЕД. 16: мотор был выключен (fdc_motor_cycle) и включён
        ; импульсом заново — без раскрутки AH=02 уходит в "not ready":
        ; шпиндель не набрал обороты. Ждём так же, как PIO-ярус
        call fdc_spinup
        mov byte [cs:fdc_motor_up], 1
.rb_spun:
        call fdc_wait_idle
        jnc .idle
        call fdc_dor_pulse      ; второй заход
        call fdc_wait_idle
.idle:
        ; осушить SENSE INTERRUPT (после RESET там до 4 результатов)
        mov cx, 4
.drain:
        push cx
        call fdc_sense_int
        pop cx
        loop .drain
        ; SPECIFY: SRT=6мс, HUT=240мс, HLT=8-12мс, ND=0 (DMA-режим!).
        ; ТРЕТИЙ БАЙТ: биты 7-1 = HLT, БИТ 0 = ND. 0x05 = ND=1 (!) —
        ; именно он оставлял контроллер в non-DMA перед BIOS-чтениями
        ; (порча «первый байт верный, дальше мусор»). Правильный ND=0 —
        ; это 0x04: тот же HLT, бит 0 СБРОШЕН.
        mov bl, 0x03
        call fdc_out
        mov bl, 0xCF
        call fdc_out
        mov bl, 0x04            ; HLT=2, ND=0 (бит 0 = 0!)
        call fdc_out
        ; скорость — только если известна (иначе оставляем BIOS-у)
        cmp byte [cs:fdc_ccr_known], 0
        je  .noccr
        mov al, [cs:fdc_ccr]
        and al, 0x03
        mov dx, FDC_CCR
        out dx, al
        FDC_IOWAIT
.noccr:
        ; РЕД. 12: int 13h AH=00 УБРАН. На TA-NC529 BIOS ждёт IRQ6
        ; без таймаута: в логе железа после 'L4' ни маркера 'B', ни
        ; 'F'-дампа — висяк внутри fdc_recover_bios ДО BIOS-чтения,
        ; т.е. в AH=00. Состояние BIOS синхронизируем вручную —
        ; ровно то, что AH=00 оставлял бы после сброса+recal:
        push ds
        mov ax, 0x0040
        mov ds, ax
        mov byte [0x0040], 0xFF ; счётчик мотора = макс
        mov byte [0x0094], 0    ; кэш цилиндра drive 0 (голова реально
        mov byte [0x0095], 0    ; на C0 после нашего recal; без этого
                                ; BIOS пропускал seek и читал «не там»)
        mov al, [0x003E]
        and al, 0xFC            ; recal-pending drives 0/1 сброшены:
                                ; иначе BIOS AH=02 запустил бы СВОЙ
                                ; recal с вечным ожиданием IRQ6
        mov cl, [cs:fdc_unit]
        mov ah, 0x80
        shr ah, cl              ; бит мотора юнита (0->0x80, 1->0x40)
        or  al, ah              ; мотор уже крутит — пусть BIOS знает
        mov [0x003E], al
        pop ds
        pop ds
        pop dx
        pop cx
        pop ax
        ret

; ------------------------------------------------------------
; fdc_motor_cycle: выключить мотор, пауза ~1-2.5 c (та же
; калибровка, что spinup), флаг мотора сброшен: следующий PIO-цикл
; сделает раскрутку заново, BIOS сам заведёт мотор при AH=02.
; Лечит «залипший» шпиндель/интерфейс привода.
; ------------------------------------------------------------
fdc_motor_cycle:
        push ax
        push dx
        mov al, [cs:fdc_unit]
        or  al, 0x0C            ; RESET=1, IRQ/DMA=1, МОТОР ВЫКЛЮЧЕН
        mov dx, FDC_DOR
        out dx, al
        FDC_IOWAIT
        call fdc_mot_keep       ; РЕД. 15: пауза ~2.5-3.3 c с выключенным
                                ; мотором — счётчик 0x40:0x40 должен быть
                                ; на максимуме, иначе int 08h сбросит бит
                                ; юнита в 0x40:0x3E и запишет DOR в момент
                                ; повторной раскрутки
        call fdc_spinup
        mov byte [cs:fdc_motor_up], 0
        pop dx
        pop ax
        ret

; ------------------------------------------------------------
; fdc_bios_read: чтение сектора fdc_C/H/R через BIOS int 13h в
; fdc_dst_seg:off. ЯРУС ПО УМОЛЧАНИЮ: тот же путь, что у stage1
; (на TA-NC529 читает диск идеально) и у CP/M-дискет. Код ошибки
; BIOS сохраняется в fdc_bios_ah для диагностики ('b'+AH).
; CF от int 13h.
; ------------------------------------------------------------
fdc_bios_read:
        push ax
        push bx
        push cx
        push dx
        push es
        push di
        push si
        push ds
        ; РЕД. 16: если мотор по нашему флагу не поднят (после
        ; fdc_motor_cycle без последующего PIO-раскрута), BIOS включит
        ; его и сразу полезнет читать — AH=02 вернёт "not ready",
        ; потому что шпиндель не набрал обороты. Раскручиваем сами,
        ; тем же порядком, что и PIO-ярус
        cmp byte [cs:fdc_motor_up], 0
        jne .br_motup
        call fdc_mot_keep
        call fdc_dor_motor
        mov dx, FDC_DOR
        out dx, al
        call fdc_spinup
        mov byte [cs:fdc_motor_up], 1
.br_motup:
        ; Не даём BIOS погасить мотор по своему таймеру: серия
        ; чтений может длиться дольше стандартных 2 с мотора.
        push ds
        mov ax, 0x0040
        mov ds, ax
        mov byte [0x0040], 0xFF     ; счётчик motor-off = макс
        pop ds
        ; ДИАГНОСТИКА ВИСЯКОВ: при поднятой лестнице печатаем 'B'+цилиндр
        ; перед КАЖДОЙ BIOS-попыткой: если машина умрёт молча, по экрану
        ; видно, на каком цилиндре сидит int 13h (документированный
        ; режим TA-NC529: ждёт IRQ6 без таймаута)
        cmp byte [cs:fdc_escalated], 0
        je  .br_nodiag
        pusha
        mov al, 'B'
        call debug_char
        mov al, [cs:fdc_C]
        call screen_hex_byte
        mov al, ' '
        call debug_char
        popa
.br_nodiag:
        ; РЕД. 15: на время int 13h вернуть вектор int 0Eh BIOS и
        ; разрешить IRQ6 — его обработчик сам ждёт и разбирает своё
        ; прерывание (без этого AH=02 зависает на своём внутреннем
        ; ожидании IRQ6). Возврат своего вектора и маски — сразу после
        ; int 13h в обеих ветках (fdc_bios_rearm), ДО копирования.
        call fdc_bios_arm
        mov cl, [cs:fdc_R]          ; сектор (1-based), биты 0-5 CL
        mov al, [cs:fdc_C]
        mov ch, al                  ; младшие 8 бит цилиндра
        ; Старшие биты цилиндра (CL биты 6-7): у НГМД цилиндр <= 79,
        ; биты 8-9 всегда нулевые, до-упаковывать в CL нечего.
        mov ax, 0x0201              ; AH=02 read, AL=1 сектор

        ; ГРАНИЦА 64К ДЛЯ DMA: BIOS читает через контроллер DMA,
        ; который не умеет пересекать 64К-границу. Если ES:BX+511
        ; пересекает границу — читаем в bounce-буфер 0000:7C00
        ; (труп stage1) и копируем на место.
        mov di, es
        mov dx, di
        shl dx, 4                   ; DX = (ES*16) & 0xFFFF
        add dx, bx                  ; + смещение приёмника
        add dx, 0x1FF               ; + последний байт сектора
        jc  .br_bounce              ; перенос = пересечение
        mov es, [cs:fdc_dst_seg]
        mov bx, [cs:fdc_dst_off]
        mov dh, [cs:fdc_H]
        mov dl, [cs:drive]
        int 0x13
        mov [cs:fdc_bios_ah], ah    ; код ошибки BIOS (0 при успехе)
        call fdc_bios_rearm     ; РЕД. 15: свой вектор/маска сразу
        jmp .br_ret
.br_bounce:
        ; чтение в bounce 0000:7C00, затем копия на место
        xor ax, ax
        mov es, ax
        mov bx, 0x7C00
        mov ax, 0x0201
        mov dh, [cs:fdc_H]
        mov dl, [cs:drive]
        int 0x13
        mov [cs:fdc_bios_ah], ah
        call fdc_bios_rearm     ; РЕД. 15: свой вектор/маска ДО копии —
                                ; ложное IRQ6 в окне rep movsw не уходит
                                ; в обработчик BIOS (внешний ревью)
        jc .br_ret
        push ds
        xor ax, ax
        mov ds, ax
        mov si, 0x7C00
        mov es, [cs:fdc_dst_seg]
        mov di, [cs:fdc_dst_off]
        mov cx, 256
        cld
        rep movsw
        pop ds
        clc
.br_ret:
        ; РЕД. 15: маска IRQ6 и свой вектор уже возвращены —
        ; fdc_bios_rearm вызван сразу после int 13h в обеих ветках.
        ; CF — результат int 13h (fdc_bios_rearm флаги не трогает).
        ; При успехе BIOS-обработчик сам разобрал своё прерывание —
        ; осушать нечего; при провале возможны застрявшие результаты.
        jnc .br_nomess
        mov cx, 4
.br_drain:
        push cx
        call fdc_sense_int
        pop cx
        loop .br_drain
.br_nomess:
        pop ds
        pop si
        pop di
        pop es
        pop dx
        pop cx
        pop bx
        pop ax
        ret

; ------------------------------------------------------------
; fdc_reset: полный сброс контроллера + SPECIFY с ND=0 + drain
; SENSE INTERRUPT + скорость данных из fdc_ccr. CF=0 при успехе.
;
; ND=0, А НЕ ND=1: non-DMA нужен ТОЛЬКО фазе данных READ (его
; включает fdc_read_op непосредственно перед командой). На
; CS5530 SPECIFY с ND=1 до recalibrate ломал ВСЁ: recalibrate не
; завершался ('f4 81' по каждой пробе), а SPECIFY ND=0 перед
; BIOS-фолбэком выбрасывался занятым чипом — BIOS-чтения шли
; битыми («первый байт сектора верный, дальше мусор»).
; ------------------------------------------------------------
fdc_reset:
        push ax
        push bx
        push cx
        push dx
        mov byte [cs:fdc_calibrated], 0
        mov byte [cs:fdc_cyl_cur], 0xFF
        mov byte [cs:fdc_motor_up], 0
        mov byte [cs:fdc_inited], 1
        call fdc_mot_keep       ; РЕД. 14: защитить мотор ДО spinup:
                                ; счётчик stage1 догорал, и int 08h
                                ; гасил мотор прямо в spinup — recal
                                ; без шпинделя не завершается ('f481')

        ; RESET=0, мотор выключен
        mov al, [cs:fdc_unit]
        or  al, 0x08
        mov dx, FDC_DOR
        out dx, al
        FDC_IOWAIT
        call fdc_delay_2ms

        ; RESET=1 + мотор юнита
        call fdc_dor_motor
        mov dx, FDC_DOR
        out dx, al
        FDC_IOWAIT
        call fdc_spinup
        mov byte [cs:fdc_motor_up], 1

        ; готовность: RQM=1, DIO=0, CB=0
        mov byte [cs:fdc_ph], PH_READY
        call fdc_ph_mark        ; РЕД. 14: трасса фаз на эскалациях
        mov al, 0x80
        mov ah, 0xD0
        mov cx, TMO_READY
        call fdc_wait_msr
        jc .rs_fail

        ; SPECIFY: SRT=6мс, HUT=240мс, HLT=8-12мс, ND=0 (DMA-режим).
        ; ГЛАВНЫЙ ФИКС ЗАГРУЗКИ НА РЕАЛЬНОМ ЖЕЛЕЗЕ: третий байт SPECIFY —
        ; биты 7-1 HLT, БИТ 0 = ND. Здесь годами стоял 0x05 = ND=1 при
        ; комментарии «ND=0» — то есть «исправление ND=0 перед
        ; recalibrate» из шапки НИКОГДА не применялось. На CS5530
        ; RECALIBRATE/SEEK с ND=1 не завершаются вовсе ('f481': фаза 4,
        ; MSR=0x81, SENSE INTERRUPT вечно INVALID) — лестница выживала
        ; только после случайного BIOS AH=00, а застрявший ND=1 портил
        ; и последующие BIOS DMA-чтения. Правильно: 0x04 = тот же HLT,
        ; ND=0.
        mov byte [cs:fdc_ph], PH_SPECIFY
        call fdc_ph_mark        ; РЕД. 14
        mov bl, 0x03
        call fdc_out
        jc .rs_fail
        mov bl, 0xCF
        call fdc_out
        jc .rs_fail
        mov bl, 0x04            ; HLT=2 (биты 7-1), ND=0 (бит 0 = 0!)
        call fdc_out
        jc .rs_fail

        ; скорость данных. После сброса чип по умолчанию даёт 250
        ; кбит/с, поэтому скорость программируем явно: чтение
        ; DD-медиа (720K/360K) на 500 кбит/с даёт таймаут фазы
        ; данных (FDC не находит адресные метки), HD-медиа
        ; (1.2M/1.44M) наоборот требует 500. Значение — из fdc_ccr:
        ; bpb_init ставит по BPB (spt<=9 -> 250, иначе 500); до
        ; разбора BPB PIO-ярус ротирует 500/250/300 сам.
        ; ПИШЕМ ТОЛЬКО В CCR (0x3F7): запись в DSR (0x3F4 на запись)
        ; на TA-NC529/CS5530 убивала CPU молча (см. шапку).
        cmp byte [cs:fdc_ccr_force], 0
        je  .rs_noccr
        mov al, [cs:fdc_ccr]
        and al, 0x03
        mov dx, FDC_CCR
        out dx, al
        FDC_IOWAIT
.rs_noccr:

        ; осушить очередь SENSE INTERRUPT (после reset)
        mov byte [cs:fdc_ph], PH_SENSED
        call fdc_ph_mark        ; РЕД. 14
        mov cx, 4
.rs_drain:
        push cx
        call fdc_sense_int
        pop cx
        jc .rs_fail
        mov al, [cs:fdc_st0]
        mov ah, al
        and ah, 0xC0
        cmp ah, 0x80            ; INVALID = очередь пуста
        je  .rs_done
        loop .rs_drain
.rs_done:
        clc
        jmp .rs_ret
.rs_fail:
        stc
.rs_ret:
        pop dx
        pop cx
        pop bx
        pop ax
        ret

; ------------------------------------------------------------
; fdc_wait_seek_done: дождаться завершения RECALIBRATE/SEEK.
;
; SEEK/RECALIBRATE — команды БЕЗ фазы результата; после приёма
; байт MSR = 0x8n (RQM + бит busy юнита), и он МОЛЧИТ, пока голова
; физически движется (на CS5530 — до сотен мс).
;
; ГЛАВНЫЙ ПУТЬ (РЕД. 15): сигнал IRQ6 завершения команды. История
; отладки TA-NC529: опрос SENSE INTERRUPT ВО ВРЕМЯ исполнения
; seek/recal на CS5530 не находит завершение НИКОГДА ('f481' по
; каждой PIO-попытке с 14 ноября: SENSEI вечно INVALID, ST0=0x80,
; при том что BIOS этой машины завершает те же seek'и, ловя сигнал
; IRQ6 своим обработчиком int 0Eh). Завершение теперь ловит наш
; fdc_irq6_isr (флаг + EOI), а wait_seek_done ждёт флаг и по нему
; делает ОДИН SENSEI. Пока команда исполняется, чип НЕ ТРОГАЕТСЯ
; ВОВСЕ (поведение BIOS: только чтение MSR и ожидание сигнала);
; спасательный опрос SENSEI/SENSE DRIVE STATUS включается, когда
; чип в покое, или после ~2 c тишины (эмуляторы и чипы без IRQ6):
;   - CF от fdc_out (чип занят, запись отвергнута) — не фатально,
;     ждём дальше;
;   - ST0 INVALID (очередь пуста, чип в покое) — проверяем физику
;     через SENSE DRIVE STATUS: для recal ST3.T0 (бит 4) = голова
;     на треке 0; для seek чип принял SENSE DRIVE STATUS и ответил
;     INVALID = команда закончилась (позицию подтвердит фаза
;     результатов READ);
;   - валидный ST0 -> успех (fdc_st0/BH=PCN).
; Выход: CF=0 — валидный ST0 (BL=ST0, BH=PCN); CF=1 — таймаут.
; ------------------------------------------------------------
fdc_wait_seek_done:
        ; ВНИМАНИЕ: BX НЕ сохраняем — результат в BL=ST0 и BH=PCN.
        push ax
        push cx
        push dx
        push si
        push di                 ; DI = счётчик итераций
        push ds
        mov ax, 0x0040
        mov ds, ax
        mov cx, [0x006C]        ; стартовый тик BIOS
        xor ax, ax
        mov ds, ax
        mov byte [cs:fdc_irq6_flag], 0  ; чужие/старые флаги — мимо
        mov di, 70              ; итерационный кап: выход гарантирован
                                ; даже при стоящем счётчике тиков
                                ; (п.11б шапки)
        mov si, 36              ; итераций молчаливого ожидания (~2 c):
                                ; пока чип занят, он не трогается вовсе;
                                ; после — спасательный опрос
.wsd_poll:
        ; 1) ГЛАВНЫЙ ПУТЬ: прерывание завершения поймано fdc_irq6_isr
        cmp byte [cs:fdc_irq6_flag], 0
        je  .wsd_noirq
        mov byte [cs:fdc_irq6_flag], 0
        call fdc_sense_int      ; по сигналу IRQ6 — один SENSEI
        jnc .wsd_check
        jmp .wsd_again
.wsd_noirq:
        ; 2) ЧИП ЗАНЯТ (seek/recal исполняется, биты DSB в MSR)?
        ; Пока да — НЕ ТРОГАЕМ ЕГО ВОВСЕ (поведение BIOS: только
        ; чтение MSR и ожидание сигнала; команды посреди исполнения
        ; на CS5530 недопустимы — п.13 шапки). Первые ~2 c (SI)
        ; ждём сигнал молча; дальше — спасопрос SENSEI/STS на случай
        ; потерянного прерывания (поведение РЕД. 12-14)
        mov dx, FDC_MSR
        in  al, dx
        test al, 0x0F           ; биты DSB: хоть один привод занят?
        jz  .wsd_idlepoll       ; чип в покое — можно опрашивать
        cmp si, 0
        je  .wsd_idlepoll       ; половина дедлайна прошла — спасопрос
        dec si
        jmp .wsd_again          ; молча ждём сигнал IRQ6
.wsd_idlepoll:
        ; 3) запасной путь: SENSEI без сигнала (INVALID = чип в покое)
        call fdc_sense_int
        jnc .wsd_check
        jmp .wsd_sts
.wsd_check:
        mov al, [cs:fdc_st0]
        mov ah, al
        and ah, 0xC0
        cmp ah, 0x80            ; INVALID = очередь пуста, чип в покое
        je  .wsd_sts            ; физическая проверка завершения
        clc                     ; валидный ST0: BL=ST0, BH=PCN
        jmp .wsd_ret
.wsd_sts:
        ; 3) запасной путь: физическое состояние через SENSE DRIVE
        ; STATUS (ST3: T0 (бит 4) для recal). На CS5530 опрос SENSEI
        ; посреди команды завершения не находит — SENSE DRIVE STATUS
        ; даёт позицию головы напрямую
        mov bl, 0x04
        call fdc_out
        jc  .wsd_again          ; не принято — команда ещё исполняется
        mov bl, [cs:fdc_H]
        shl bl, 2
        or  bl, [cs:fdc_unit]
        call fdc_out
        jc  .wsd_again
        call fdc_in
        jc  .wsd_again          ; ST3 не пришёл — ждём дальше
        mov [cs:fdc_st3], bl
        cmp byte [cs:fdc_ph], PH_RECAL
        je  .wsd_recal
        ; SEEK: чип принял SENSE DRIVE STATUS и ответил SENSEI
        ; INVALID — команда закончилась. Позицию подтвердит фаза
        ; результатов READ (C != цель => провал).
        mov bh, [cs:fdc_stmp]
        mov bl, 0x20            ; синтез ST0: IC=00, SE=1
        mov [cs:fdc_st0], bl
        clc
        jmp .wsd_ret
.wsd_recal:
        test bl, 0x10           ; ST3.T0: голова уже на треке 0?
        jz  .wsd_again          ; нет — recal продолжается, ждём
        call fdc_sense_int      ; осушить завершение recal, если сигнал
                                ; IRQ6 ещё не разобран: чужой флаг не
                                ; должен имитировать завершение
                                ; СЛЕДУЮЩЕЙ команды (bh/bl — после)
        mov bh, 0               ; PCN = 0
        mov bl, 0x20            ; синтез ST0: IC=00, SE=1
        mov [cs:fdc_st0], bl
        clc
        jmp .wsd_ret
.wsd_again:
        call fdc_settle         ; пауза ~50-60 мс между опросами
        dec di
        jz  .wsd_dump           ; кап итераций — выход даже при
                                ; замёрзшем счётчике тиков (п.11б)
        ; дедлайн по тикам: (текущий - стартовый) >= 72 -> таймаут
        push ax
        push bx
        mov ax, 0x0040
        mov ds, ax
        mov ax, [0x006C]
        xor bx, bx
        mov ds, bx
        sub ax, cx
        cmp ax, 72              ; ~4 c (РЕД. 15: было 45 — запас на
        pop bx                  ; холодный привод и медленную шину,
                                ; внешний ревью)
        pop ax
        jb  .wsd_poll
.wsd_dump:
        ; таймаут: 'Q'+ST0+ST3 — что отвечали SENSEI и SENSE DRIVE
        ; STATUS к моменту сдачи. ST0=80 — завершение так и не пришло;
        ; ST3 с битом 0x10 (T0) — голова на треке 0. Диагностика для
        ; следующего лога железа.
        push ax
        mov al, 'Q'
        call debug_char
        mov al, [cs:fdc_st0]
        call screen_hex_byte
        mov al, [cs:fdc_st3]
        call screen_hex_byte
        mov al, ' '
        call debug_char
        pop ax
        stc
.wsd_ret:
        pop ds
        pop di
        pop si
        pop dx
        pop cx
        pop ax
        ret

; ------------------------------------------------------------
; fdc_recal: RECALIBRATE (головка на цилиндр 0). CF=0 при успехе.
; ------------------------------------------------------------
; РЕД. 16: флаг IRQ6 очищается ДО выдачи команды (мгновенное
; завершение recal — голова уже на треке 0 — больше не теряется между
; fdc_out и входом в wait_seek_done); грязный ST0 (IC!=00/EC/PCN!=0)
; осушается до 3 дополнительных SENSEI (собственный результат recal
; мог стоять за чужим — хвост сброса/poll-режима); при неудаче recal
; повторяется один раз после полного fdc_reset — лог железа РЕД. 16
; показал, что после сброса recal завершается чисто (попытка 2:
; 'f481' на 500 кбит/с -> успех на 300).
fdc_recal:
        push bx
        push cx
        mov cx, 2               ; одна чистая попытка + одна после сброса
.rc_try:
        mov byte [cs:fdc_ph], PH_RECAL
        call fdc_ph_mark        ; РЕД. 14: трасса фаз на эскалациях
        mov byte [cs:fdc_irq6_flag], 0
        mov bl, 0x07
        call fdc_out
        jc .rc_bad
        mov bl, [cs:fdc_unit]
        call fdc_out
        jc .rc_bad
        call fdc_wait_seek_done
        jc .rc_bad
        mov al, [cs:fdc_st0]
        test al, 0xC0
        jnz .rc_stale           ; IC != 00 — возможно, чужой результат
        test al, 0x10
        jnz .rc_stale           ; equipment check
        test al, 0x20
        jz  .rc_stale           ; нет признака seek-end
        test bh, bh
        jnz .rc_stale           ; PCN != 0
        jmp .rc_ok
.rc_stale:
        push cx
        mov cx, 3
.rc_drain:
        call fdc_sense_int      ; РЕД. 16: ищем ЧИСТЫЙ результат recal за
        jc  .rc_drain_done      ; чужим; INVALID = результатов больше нет
        mov al, [cs:fdc_st0]    ; (чип в покое) — осушение кончилось
        test al, 0xC0
        jnz .rc_drain_next
        test al, 0x20
        jz  .rc_drain_next
        test bh, bh
        jnz .rc_drain_next
        pop cx
        jmp .rc_ok
.rc_drain_next:
        loop .rc_drain
.rc_drain_done:
        pop cx
.rc_bad:
        dec cx
        jz  .rc_fail
        call fdc_reset          ; РЕД. 16: повтор после полного сброса
        jc  .rc_fail
        jmp .rc_try
.rc_ok:
        mov byte [cs:fdc_cyl_cur], 0
        mov byte [cs:fdc_calibrated], 1
        clc
        jmp .rc_ret
.rc_fail:
        stc
.rc_ret:
        pop cx
        pop bx
        ret

; ------------------------------------------------------------
; fdc_seek: BL = целевой цилиндр. CF=0 при успехе.
; ------------------------------------------------------------
fdc_seek:
        push bx
        push cx
        mov byte [cs:fdc_ph], PH_SEEK
        call fdc_ph_mark        ; РЕД. 14
        mov byte [cs:fdc_irq6_flag], 0  ; РЕД. 16: до команды (см. fdc_recal)
        mov al, bl
        mov [cs:fdc_stmp], al
        mov bl, 0x0F
        call fdc_out
        jc .sk_fail
        mov bl, [cs:fdc_H]
        shl bl, 2
        or  bl, [cs:fdc_unit]
        call fdc_out
        jc .sk_fail
        mov bl, [cs:fdc_stmp]
        call fdc_out
        jc .sk_fail
        call fdc_wait_seek_done
        jc .sk_fail
        mov al, [cs:fdc_st0]
        test al, 0xC0
        jnz .sk_stale
        test al, 0x10
        jnz .sk_stale
        test al, 0x20
        jz  .sk_stale
        mov al, [cs:fdc_stmp]
        cmp bh, al
        jne .sk_stale           ; PCN != цель
        jmp .sk_ok
.sk_stale:
        ; РЕД. 16: чужой результат SENSEI (хвост сброса/poll) — осушаем
        ; до 3 результатов в поиске чистого seek-end с верным PCN
        push cx
        mov cx, 3
.sk_drain:
        call fdc_sense_int
        jc  .sk_drain_done
        mov al, [cs:fdc_st0]
        test al, 0xC0
        jnz .sk_drain_next
        test al, 0x20
        jz  .sk_drain_next
        mov al, [cs:fdc_stmp]
        cmp bh, al
        jne .sk_drain_next
        pop cx
        jmp .sk_ok
.sk_drain_next:
        loop .sk_drain
.sk_drain_done:
        pop cx
        jmp .sk_fail
.sk_ok:
        call fdc_settle
        mov al, [cs:fdc_stmp]
        mov [cs:fdc_cyl_cur], al
        clc
        jmp .sk_ret
.sk_fail:
        stc
.sk_ret:
        pop cx
        pop bx
        ret

; ------------------------------------------------------------
; fdc_read_op: READ DATA сектора fdc_C/H/R в приёмник.
; CF=0 при успехе.
; РЕД. 12: non-DMA (ND=1) упразднён. На CS5530 ND=1 не только вешал
; recalibrate (п.8), но и уводил чип в исполнение посреди командной
; фазы READ: 'f630' = фаза 6, MSR=0x30 (RQM=0, DIO=1, NDM=1) — чип
; перестаёт принимать байты команды. Фаза данных переведена на ISA
; DMA CH2 — механизм, которым stage1 (BIOS int 13h) читает дискету
; на этой машине безупречно. Порядок: SPECIFY ND=0, программирование
; DMA в bounce 0000:0x7C00 (страница 0 — пересечение границы 64К
; исключено по построению), READ DATA, ожидание фазы результатов,
; копия 512 байт в fdc_dst_seg:off.
; ------------------------------------------------------------
fdc_read_op:
        mov byte [cs:fdc_irq6_flag], 0  ; РЕД. 15: старый/чужой флаг IRQ6
                                        ; не должен имитировать завершение
        mov byte [cs:fdc_ph], PH_SPECIFY
        call fdc_ph_mark        ; РЕД. 14
        mov bl, 0x03
        call fdc_out
        jc .ro_fail
        mov bl, 0xCF
        call fdc_out
        jc .ro_fail
        mov bl, 0x04            ; HLT=2, ND=0 (РЕД. 12: DMA-режим)
        call fdc_out
        jc .ro_fail

        ; --- программирование ISA DMA CH2: приёмник 0000:0x7C00 ---
        ; (труп stage1 — память свободна; страница 0: граница 64К
        ; не пересекается по построению). Канал маскируем на время
        ; программирования, триггер адреса сбрасываем, затем адрес/
        ; страница/счётчик/режим и снятие маски — ДО команды READ:
        ; чип в DMA-режиме ждёт сигналов DMAC, а не CPU.
        mov al, 0x06            ; маска CH2
        out 0x0A, al
        xor al, al              ; сброс триггера младший/старший
        out 0x0C, al
        mov al, 0x00            ; адрес 0x7C00: младший байт
        out 0x04, al
        mov al, 0x7C            ; старший байт
        out 0x04, al
        mov al, 0x00            ; страница = 0 (физ. 0x07C00)
        out 0x81, al
        mov al, 0xFF            ; счётчик 511 (512 байт): младший
        out 0x05, al
        mov al, 0x01            ; старший
        out 0x05, al
        mov al, 0x46            ; режим: CH2, IO->память, single, инкремент
        out 0x0B, al
        mov al, 0x02            ; снять маску CH2
        out 0x0A, al

        mov byte [cs:fdc_ph], PH_READCMD
        call fdc_ph_mark        ; РЕД. 14
        mov bl, 0x46            ; READ DATA: MFM=1, MT=0, SK=0
        call fdc_out
        jc .ro_fail
        mov bl, [cs:fdc_H]
        shl bl, 2
        or  bl, [cs:fdc_unit]
        call fdc_out
        jc .ro_fail
        mov bl, [cs:fdc_C]
        call fdc_out
        jc .ro_fail
        mov bl, [cs:fdc_H]
        call fdc_out
        jc .ro_fail
        mov bl, [cs:fdc_R]
        call fdc_out
        jc .ro_fail
        mov bl, 0x02            ; N=2: сектор 512 байт (9-байтовая
        call fdc_out            ; команда READ DATA по 82077!)
        jc .ro_fail
        mov bl, [cs:fdc_R]      ; EOT = R: ровно один сектор
        call fdc_out
        jc .ro_fail
        mov bl, 0x1B            ; GPL
        call fdc_out
        jc .ro_fail
        mov bl, 0xFF            ; DTL
        call fdc_out
        jc .ro_fail

        ; фаза данных идёт через DMA: CPU не трогает FIFO. Ждём
        ; фазы результатов (RQM=1, DIO=1) с ДЛИННЫМ таймаутом
        ; (TMO_CMD ~ 2 оборота дискеты): FDC должен найти заголовок
        ; сектора и отдать 512 байт через DMAC. По достижении TC
        ; (512-й байт) чип сам переходит в фазу результатов.
        mov byte [cs:fdc_ph], PH_DATA
        call fdc_ph_mark        ; РЕД. 14
        mov al, 0xC0
        mov ah, 0xC0
        mov cx, TMO_CMD
        call fdc_wait_msr
        jnc .ro_results
        ; РЕД. 16: фаза результатов не пришла за TMO_CMD, чип ещё
        ; исполняет READ (MSR=0x10: CB=1, RQM=0 — ждёт циклов DMA).
        ; Проверяем остаток счётчика канала 2: 0xFFFF означает, что все
        ; 512 байт прошли по DMA и канал дошёл до TC (чип терминальный
        ; счёт не увидел — причуда CS5530). Данные в bounce годны —
        ; спасаем, зависшую команду прерываем импульсом RESET.
        ; Любой другой остаток = DMA не прошёл — сдаёмся как раньше.
        xor al, al
        out 0x0C, al            ; сброс указателя младший/старший
        FDC_IOWAIT
        in  al, 0x05            ; счётчик CH2, младший байт
        mov bl, al
        in  al, 0x05            ; старший байт
        mov bh, al
        cmp bx, 0xFFFF          ; TC достигнут?
        jne .ro_drain
        pusha
        mov al, 'D'             ; РЕД. 16: спасение фазы данных по TC
        call debug_char
        mov al, bl
        call screen_hex_byte
        mov al, bh
        call screen_hex_byte
        mov al, ' '
        call debug_char
        popa
        call fdc_dor_pulse      ; READ висит без TC — прервать
        mov byte [cs:fdc_calibrated], 0 ; позиция после RESET неизвестна:
        mov byte [cs:fdc_cyl_cur], 0xFF ; следующий сектор начнёт с recal
        push ds
        xor ax, ax
        mov ds, ax
        mov si, 0x7C00
        mov es, [cs:fdc_dst_seg]
        mov di, [cs:fdc_dst_off]
        mov cx, 256
        cld
        rep movsw
        pop ds
        clc
        ret
.ro_results:

        ; фаза результатов: ровно 7 байт ST0 ST1 ST2 C H R N
        mov byte [cs:fdc_ph], PH_RESULT
        call fdc_ph_mark        ; РЕД. 14
        call fdc_in
        jc .ro_fail
        mov [cs:fdc_st0], bl
        call fdc_in
        jc .ro_fail
        mov [cs:fdc_st1], bl
        call fdc_in
        jc .ro_fail
        mov [cs:fdc_st2], bl
        call fdc_in
        jc .ro_fail
        mov [cs:fdc_rc], bl     ; C
        call fdc_in
        jc .ro_fail             ; H — не нужен
        call fdc_in
        jc .ro_fail
        mov [cs:fdc_rr], bl     ; R
        call fdc_in
        jc .ro_fail             ; N — не нужен

        ; проверка результатов
        mov byte [cs:fdc_ph], PH_VERIFY
        call fdc_ph_mark        ; РЕД. 14
        mov al, [cs:fdc_st0]
        test al, 0xC0
        jnz .ro_fail            ; IC != 00 (нормальное завершение)
        cmp byte [cs:fdc_st1], 0
        jne .ro_fail
        cmp byte [cs:fdc_st2], 0
        jne .ro_fail
        mov al, [cs:fdc_rc]
        cmp al, [cs:fdc_C]
        jne .ro_fail            ; головка не там
        mov al, [cs:fdc_rr]
        cmp al, [cs:fdc_R]
        jne .ro_fail
        mov al, [cs:fdc_C]
        mov [cs:fdc_cyl_cur], al
        ; РЕД. 12: данные приняты DMA в bounce 0000:0x7C00 — копия
        ; в приёмник fdc_dst_seg:off (как их писал старый ND-поллинг).
        push ds
        xor ax, ax
        mov ds, ax
        mov si, 0x7C00
        mov es, [cs:fdc_dst_seg]
        mov di, [cs:fdc_dst_off]
        mov cx, 256
        cld
        rep movsw
        pop ds
        clc
        ret
.ro_drain:
        ; ОСУШЕНИЕ ХВОСТА ФАЗЫ РЕЗУЛЬТАТОВ (C H R N): без него
        ; контроллер висит в фазе результатов и первый fdc_out
        ; следующей попытки упирается в таймаут.
        push cx
        push ax
        mov cx, 4
.ro_drain_loop:
        push cx
        mov al, 0xC0
        mov ah, 0xC0
        mov cx, 1
        call fdc_wait_msr
        pop cx
        jc  .ro_drain_done      ; байтов больше нет — хватит
        mov dx, FDC_FIFO
        in  al, dx
        FDC_IOWAIT
        loop .ro_drain_loop
.ro_drain_done:
        pop ax
        pop cx
.ro_fail:
        stc
        ret

; ------------------------------------------------------------
; fdc_wait_msr: ждать, пока (MSR & AH) == AL.
; CX = таймаут в единицах. CF=0: успех (raw MSR в BL),
; CF=1: таймаут (последний MSR — в fdc_msr_last).
; ------------------------------------------------------------
fdc_wait_msr:
        push di
        push si
        mov dx, FDC_MSR
        mov si, cx              ; ВАЖНО: таймаут сначала (целый CX),
        mov ch, al              ; и только потом ожидаемое значение в
                                ; CH — иначе SI получит (expect<<8)|tmo
.wm_outer:
        mov di, 0x800           ; РЕД. 14: единица таймаута = 2048
                                ; чтений MSR (~2-40 мс на железе),
                                ; было 65535 (~десятки секунд)
.wm_inner:
        in  al, dx
        mov bl, al
        and al, ah
        cmp al, ch
        je  .wm_ok
        dec di
        jnz .wm_inner
        dec si
        jnz .wm_outer
        mov [cs:fdc_msr_last], bl   ; запомнить MSR для диагностики
        stc
        jmp .wm_ret
.wm_ok:
        clc
.wm_ret:
        pop si
        pop di
        ret

; ------------------------------------------------------------
; fdc_out: отправить байт BL в FIFO (ждёт RQM=1, DIO=0).
;
; ПОЧЕМУ ПРОВЕРКА ТОЛЬКО RQM|DIO ((MSR&0xC0)==0x80), А НЕ СТРОГО
; «ПОЛНЫЙ ПОКОЙ»: у 82077+ после RESET включается режим поллинга, и
; MSR легитимно держит бит ACT юнита (0x81) БЕЗ всякой застрявшей
; команды — строгая проверка ломала бы SPECIFY на реальном железе.
; От застрявших команд защищает ПОРЯДОК вызовов: перед SPECIFY при
; восстановлении всегда стоит fdc_dor_pulse (RESET прерывает всё),
; а в fdc_reset SPECIFY идёт сразу после нашего же DOR-сброса.
; CF=0 при успехе, CF=1 при таймауте.
; ------------------------------------------------------------
fdc_out:
        push bx
        push cx                 ; РЕД. 13: CX сохраняется — в
        mov bh, bl              ; fdc_wait_seek_done в CX живёт
        mov al, 0x80            ; стартовый тик дедлайна, а mov cx
        mov ah, 0xC0            ; ниже его затирал: после .wsd_sts
        mov cx, TMO_BYTEC       ; дедлайн считал от мусора (п.11а)
        call fdc_wait_msr
        jc .ou_ret
        mov al, bh
        mov dx, FDC_FIFO
        out dx, al
        FDC_ACKRQM              ; байт принят: ждём снятия RQM
.ou_ret:
        pop cx
        pop bx
        ret

; ------------------------------------------------------------
; fdc_in: принять байт из FIFO в BL (ждёт RQM=1, DIO=1)
; ------------------------------------------------------------
fdc_in:
        push cx
        mov al, 0xC0
        mov ah, 0xC0
        mov cx, TMO_BYTEC
        call fdc_wait_msr
        jc .in_ret
        mov dx, FDC_FIFO
        in  al, dx
        mov bl, al
        FDC_ACKRQM             ; байт прочитан: ждём снятия RQM (гонка MSR)
.in_ret:
        pop cx
        ret

; ------------------------------------------------------------
; fdc_sense_int: SENSE INTERRUPT STATUS.
; Выход: BL = ST0, BH = PCN. CF=1 при таймауте.
;
; Часть контроллеров/эмуляторов (86box) на SENSE INTERRUPT без
; ожидающегося прерывания отдают ТОЛЬКО ST0=0x8x (INVALID) и НЕ
; выдают второй байт (PCN) — поэтому PCN ждём коротко и считаем 0,
; если он не пришёл: INVALID-ответ без PCN — легитимный.
; Занятый seek-ом контроллер (MSR=0x8n) отвергнет команду на
; fdc_out — это НЕ фатально: fdc_wait_seek_done трактует CF как
; «команда ещё исполняется».
; ------------------------------------------------------------
fdc_sense_int:
        push cx
        mov bl, 0x08
        call fdc_out
        jc .sn_ret
        call fdc_in
        jc .sn_ret
        mov al, bl
        mov [cs:fdc_st0], al
        ; PCN: второй байт есть не всегда (86box на INVALID отдаёт
        ; только ST0). Ждём его КОРОТКО и, если пришёл, вычитываем:
        ; оставленный байт застревает в фазе результата (MSR=0xD0).
        mov al, 0xC0
        mov ah, 0xC0
        mov cx, 1               ; короткий таймаут (~1 единица)
        call fdc_wait_msr
        mov bh, 0               ; PCN по умолчанию: второго байта нет
        jc  .sn_got
        mov dx, FDC_FIFO
        in  al, dx
        FDC_IOWAIT              ; PCN вычитан, дать чипу уйти в покой
        mov bh, al              ; PCN
.sn_got:
        mov bl, [cs:fdc_st0]    ; BL = ST0 (контракт функции)
        clc
.sn_ret:
        pop cx
        ret

; ------------------------------------------------------------
; fdc_verify_cluster: НЕЗАВИСИМАЯ ПРОВЕРКА ПРОЧИТАННОГО КЛАСТЕРА.
; BIOS/PIO может вернуть CF=0 с ПОРЧЕННЫМ буфером (недетерминированная
; порча DMA на CS5530: «первый байт верный, дальше мусор», при
; чистом CRC). Единственная защита, которой нельзя обмануть
; статусом CF=0, — перечитать данные и СРАВНИТЬ.
;
; IN:  ES = сегмент приёмника (кластер начинается с offset 0);
;      fdc_vlba = LBA первого сектора кластера;
;      [cs:spc] = секторов в кластере (1-2).
; Использует scratch 0000:0x2000 (свободная память ниже BOOTINFO
; 0x5000; НЕ 0:7C00 — при spc=2 кластер размером 1024 байта заехал
; бы в тело stage2 на 0x7E00!).
; OUT: CF=0 — совпало (или верификационное чтение само не удалось:
;      вердикта нет, мешать загрузке нечем — CF даст обычная лестница);
;      CF=1 — ГАРАНТИРОВАННАЯ ПОРЧА: два чтения одного сектора дали
;      разные байты (маркер 'V' печатает вызывающий).
; ------------------------------------------------------------
fdc_verify_cluster:
        push ax
        push bx
        push cx
        push dx
        push si
        push di
        push es
        push ds
        mov ax, es
        mov [cs:fdc_vseg], ax
        mov ax, [cs:fdc_vlba]
        mov [cs:fdc_vcur], ax
        mov cx, [cs:spc]
        mov dx, 0x2000          ; offset scratch в сегменте 0
.v_loop:
        push cx
        push dx
        xor ax, ax
        mov es, ax
        mov bx, dx
        mov ax, [cs:fdc_vcur]
        call disk_read_sector   ; AX/ES сохраняет, CF — результат
        pop dx
        pop cx
        jc  .v_pass             ; верификационное чтение сорвалось:
                                ; вердикта нет — не блокируем загрузку
        add dx, 512
        inc word [cs:fdc_vcur]
        loop .v_loop
        ; сравнить: DS:SI = 0000:0x2000, ES:DI = fdc_vseg:0
        xor ax, ax
        mov ds, ax
        mov es, [cs:fdc_vseg]
        mov si, 0x2000
        xor di, di
        mov cx, [cs:spc]
        shl cx, 9               ; spc * 512 байт
        cld
        rep cmpsb
        je  .v_pass
        stc                     ; ДВА РАЗНЫХ ЧТЕНИЯ = ПОРЧА
        jmp .v_ret
.v_pass:
        clc
.v_ret:
        pop ds
        pop es
        pop di
        pop si
        pop dx
        pop cx
        pop bx
        pop ax
        ret

; ------------------------------------------------------------
; fdc_dor_motor: AL = значение DOR (unit, RESET=1, IRQ/DMA=1,
; мотор юнита).
; ------------------------------------------------------------
fdc_dor_motor:
        push cx
        mov al, [cs:fdc_unit]
        or  al, 0x0C
        mov cl, [cs:fdc_unit]
        mov ch, 0x10
        shl ch, cl
        or  al, ch
        pop cx
        ret

; ------------------------------------------------------------
; Программные задержки (без опоры на прерывания/таймер BIOS).
; ------------------------------------------------------------
fdc_delay_2ms:                  ; ~2-3 мс @100МГц
        push ax
        push dx
        mov dx, 2
.d2a:   mov ax, 0xFFFF
.d2b:   dec ax
        jnz .d2b
        dec dx
        jnz .d2a
        pop dx
        pop ax
        ret

fdc_spinup:                     ; ~2.5 c @100МГц / ~0.9 c @300МГц
        push ax
        push dx
        mov dx, 2000
.spa:   mov ax, 0xFFFF
.spb:   dec ax
        jnz .spb
        dec dx
        jnz .spa
        pop dx
        pop ax
        ret

fdc_settle:                     ; ~50-60 мс @100МГц / ~18-20 мс @300МГц:
        push ax                 ; установление головки после seek
        push dx                 ; (спека HD-привода 15 мс; старые 20
        mov dx, 40              ; циклов давали на Geode GX1 ~8-10 мс)
.sta:   mov ax, 0xFFFF
.stb:   dec ax
        jnz .stb
        dec dx
        jnz .sta
        pop dx
        pop ax
        ret
